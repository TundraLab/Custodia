<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Class="TundraDrive.Desktop.Views.RemoteBrowserView"
             x:DataType="vm:RemoteBrowserViewModel">

  <!-- Remote Google Drive browser -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto" RowSpacing="10" ColumnSpacing="8">
      <Button Grid.Row="0" Grid.Column="0"
              Classes="m3-outlined m3-compact"
              IsEnabled="{Binding CanNavigateBack}"
              ToolTip.Tip="{Binding Loc.BackButton}"
              Command="{Binding NavigateBackCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Width="12" Height="12" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
          <TextBlock FontSize="12" Text="{Binding Loc.BackButton}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button Grid.Row="0" Grid.Column="1"
              Classes="m3-tonal m3-compact"
              Content="{Binding Loc.MyDriveLabel}"
              Command="{Binding NavigateToRootCommand}" />

      <TextBox Grid.Row="0" Grid.Column="2"
               Watermark="{Binding Loc.SearchRemoteWatermark}"
               Text="{Binding SearchQuery}"
               KeyDown="OnSearchBoxKeyDown" />

      <Button Grid.Row="0" Grid.Column="3"
              Classes="m3-outlined"
              Content="{Binding Loc.SearchButton}"
              Command="{Binding SearchCommand}" />

      <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal">
        <Button Classes="m3-outlined m3-compact"
                Margin="0,0,6,4"
                Content="{Binding Loc.OpenFolderButton}"
                IsEnabled="{Binding CanOpenSelectedFolder}"
                Command="{Binding OpenNodeCommand}" />
        <Button Classes="m3-tonal m3-compact"
                Margin="0,0,6,4"
                Content="{Binding Loc.DownloadButton}"
                IsEnabled="{Binding CanDownloadSelectedFile}"
                Command="{Binding DownloadSelectedNodeCommand}" />
        <Button Classes="m3-danger-outlined m3-compact"
                Margin="0,0,6,4"
                Content="{Binding Loc.MoveToTrashButton}"
                IsEnabled="{Binding HasSelectedNode}"
                Command="{Binding TrashSelectedNodeCommand}" />
        <Button Classes="m3-outlined m3-compact"
                Margin="0,0,6,4"
                Content="{Binding Loc.NewFolderButton}"
                Command="{Binding ToggleCreateFolderCommand}" />
        <Button Classes="m3-tonal m3-compact"
                Margin="0,0,6,4"
                Content="{Binding Loc.SyncLocalIntoHereButton}"
                Command="{Binding SyncLocalFoldersIntoCurrentCommand}" />
        <Button Classes="m3-filled m3-compact"
                Margin="0,0,0,4"
                Content="{Binding Loc.SyncSelectedFolderButton}"
                Command="{Binding SyncSelectedOrCurrentFolderCommand}" />
      </WrapPanel>

      <Border Grid.Row="2"
              Grid.ColumnSpan="4"
              Classes="m3-card"
              Padding="12,10"
              IsVisible="{Binding IsCreateFolderOpen}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Watermark="{Binding Loc.NewFolderPlaceholder}"
                   Text="{Binding NewFolderName}" />
          <Button Grid.Column="1"
                  Classes="m3-filled m3-compact"
                  Content="{Binding Loc.CreateFolderConfirmButton}"
                  Command="{Binding CreateFolderCommand}" />
          <Button Grid.Column="2"
                  Classes="m3-outlined m3-compact"
                  Content="{Binding Loc.CancelButton}"
                  Command="{Binding ToggleCreateFolderCommand}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Breadcrumb trail -->
    <Border Grid.Row="1" Classes="m3-card" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Breadcrumbs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RemoteBreadcrumbItem">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Classes="m3-text"
                          MinHeight="0"
                          Padding="6,3"
                          FontSize="12.5"
                          Foreground="{DynamicResource M3OnSurface}"
                          Content="{Binding Name}"
                          Command="{Binding SelectCommand}" />
                  <TextBlock Text="/" VerticalAlignment="Center" Classes="m3-meta" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Button Grid.Column="1"
                Classes="m3-outlined m3-compact"
                Content="{Binding Loc.RefreshButton}"
                Command="{Binding LoadCurrentFolderCommand}" />
      </Grid>
    </Border>

    <!-- Remote files and folders list -->
    <Border Grid.Row="2" Classes="m3-card" Padding="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0">
          <Border Padding="16,10">
            <Grid ColumnDefinitions="*,110,90,135" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="m3-meta" Text="{Binding Loc.ColName}" />
              <TextBlock Grid.Column="1" Classes="m3-meta" Text="{Binding Loc.ColType}" />
              <TextBlock Grid.Column="2" Classes="m3-meta" Text="{Binding Loc.ColSize}" />
              <TextBlock Grid.Column="3" Classes="m3-meta" Text="{Binding Loc.ColModified}" />
            </Grid>
          </Border>
          <Border Classes="m3-divider-full" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Classes="m3-rows"
                 ItemsSource="{Binding Nodes}"
                 SelectedItem="{Binding SelectedNode}"
                 DoubleTapped="OnNodeDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RemoteNodeItemViewModel">
              <Border Padding="16,10" Background="Transparent">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{Binding OpenLabel}"
                              IsVisible="{Binding IsFolder}"
                              Command="{Binding OpenCommand}" />
                    <MenuItem Header="{Binding DownloadLabel}"
                              IsVisible="{Binding !IsFolder}"
                              Command="{Binding DownloadCommand}" />
                    <MenuItem Header="{Binding SyncThisFolderLabel}"
                              IsVisible="{Binding IsFolder}"
                              Command="{Binding SyncThisFolderCommand}" />
                    <MenuItem Header="{Binding OpenInDriveLabel}"
                              Command="{Binding OpenInDriveCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding CopyNameLabel}"
                              Command="{Binding CopyNameCommand}" />
                    <MenuItem Header="{Binding CopyLinkLabel}"
                              Command="{Binding CopyLinkCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding TrashLabel}"
                              Command="{Binding TrashCommand}" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="*,110,90,135" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Width="15" Height="15"
                              Foreground="{DynamicResource M3Primary}"
                              IsVisible="{Binding IsFolder}"
                              Data="{StaticResource TundraFolderGeometry}" />
                    <PathIcon Width="15" Height="15"
                              Foreground="{DynamicResource M3OnSurfaceVariant}"
                              IsVisible="{Binding !IsFolder}"
                              Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                    <TextBlock Foreground="{DynamicResource M3OnSurface}" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <TextBlock Grid.Column="1" Classes="m3-meta" VerticalAlignment="Center" Text="{Binding TypeDisplay}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="m3-meta" VerticalAlignment="Center" Text="{Binding SizeDisplay}" />
                  <TextBlock Grid.Column="3" Classes="m3-meta" VerticalAlignment="Center" Text="{Binding ModifiedDisplay}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Classes="m3-meta" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>

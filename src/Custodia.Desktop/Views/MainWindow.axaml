<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TundraDrive.Desktop.ViewModels"
        x:Class="TundraDrive.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Loc.WindowTitle}"
        Icon="avares://Custodia/Assets/custodia-icon.png"
        Width="1120"
        Height="740"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource M3Surface}">

  <Grid>
    <LayoutTransformControl x:Name="RootLayoutTransform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding UiScaleFactor}" ScaleY="{Binding UiScaleFactor}" />
    </LayoutTransformControl.LayoutTransform>

    <Grid ColumnDefinitions="Auto,*"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
      <!-- Navigation sidebar (tonal surface elevation, borderless) -->
      <Border Grid.Column="0"
              Width="{Binding SidebarWidth}"
              Background="{DynamicResource M3SurfaceContainer}"
              BorderThickness="0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="10,14">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,0,4,16">
            <StackPanel Grid.Column="0" Spacing="3" IsVisible="{Binding !IsSidebarCompact}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="{DynamicResource TundraBrandGlyphDrawing}" Width="22" Height="22" />
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource M3OnSurface}"
                           Text="Custódia"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="m3-meta" Text="{Binding Loc.BrandSubtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="m3-text m3-icon"
                    Command="{Binding ToggleSidebarCompactCommand}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center">
              <PathIcon Width="15" Height="15"
                        Foreground="{DynamicResource M3OnSurfaceVariant}"
                        Data="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ListBox Classes="m3-nav"
                     SelectedIndex="{Binding SelectedNavigationIndex}">
              <ListBoxItem ToolTip.Tip="{Binding Loc.NavFileHub}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Width="16" Height="16"
                            Data="{StaticResource TundraCloudSyncGeometry}" />
                  <TextBlock FontSize="13.5" Text="{Binding Loc.NavFileHub}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
                </StackPanel>
              </ListBoxItem>

              <ListBoxItem ToolTip.Tip="{Binding Loc.NavSyncFolders}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Width="16" Height="16"
                            Data="{StaticResource TundraFolderGeometry}" />
                  <TextBlock FontSize="13.5" Text="{Binding Loc.NavSyncFolders}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
                </StackPanel>
              </ListBoxItem>

              <ListBoxItem ToolTip.Tip="{Binding Loc.NavTransferQueue}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Width="16" Height="16"
                            Data="{StaticResource TundraNodesGeometry}" />
                  <TextBlock FontSize="13.5" Text="{Binding Loc.NavTransferQueue}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
                </StackPanel>
              </ListBoxItem>

              <ListBoxItem ToolTip.Tip="{Binding Loc.NavActivityLogs}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Width="16" Height="16"
                            Data="{StaticResource TundraTelemetryGeometry}" />
                  <TextBlock FontSize="13.5" Text="{Binding Loc.NavActivityLogs}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
                </StackPanel>
              </ListBoxItem>

              <ListBoxItem ToolTip.Tip="{Binding Loc.NavSettings}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Width="16" Height="16"
                            Data="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                  <TextBlock FontSize="13.5" Text="{Binding Loc.NavSettings}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
                </StackPanel>
              </ListBoxItem>

              <ListBoxItem ToolTip.Tip="{Binding Loc.NavAbout}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Width="16" Height="16"
                            Data="{StaticResource TundraBrandGlyphGeometry}" />
                  <TextBlock FontSize="13.5" Text="{Binding Loc.NavAbout}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
                </StackPanel>
              </ListBoxItem>
            </ListBox>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Spacing="10" Margin="2,10,2,0">
            <Border Classes="m3-divider-full" />

            <!-- Compact avatar when sidebar is collapsed -->
            <Grid Width="32"
                  Height="32"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsSidebarCompact}"
                  ToolTip.Tip="{Binding AccountsVm.EmailAddress}">
              <Ellipse Width="32"
                       Height="32"
                       Fill="{DynamicResource M3SurfaceContainerHigh}"
                       IsVisible="{Binding !HasAccountAvatar}" />
              <PathIcon Width="14"
                        Height="14"
                        Foreground="{DynamicResource M3OnSurfaceVariant}"
                        IsVisible="{Binding !HasAccountAvatar}"
                        Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
              <Ellipse Width="32"
                       Height="32"
                       Stroke="{DynamicResource M3OutlineVariant}"
                       StrokeThickness="1"
                       IsVisible="{Binding HasAccountAvatar}">
                <Ellipse.Fill>
                  <ImageBrush Source="{Binding AccountAvatarBitmap}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Ellipse.Fill>
              </Ellipse>
            </Grid>

            <!-- Elevated account and storage summary card -->
            <Border Classes="m3-card-elevated"
                    Padding="12"
                    IsVisible="{Binding !IsSidebarCompact}">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding Loc.AddAccountMenu}"
                            Command="{Binding AccountsVm.AddAccountCommand}" />
                  <MenuItem Header="{Binding Loc.CredentialsAccountsSectionTitle}"
                            Command="{Binding OpenAccountSettingsCommand}" />
                  <MenuItem Header="{Binding Loc.RefreshQuotaButton}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding AccountsVm.RefreshCommand}" />
                  <MenuItem Header="{Binding Loc.OpenTrashTooltip}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding OpenTrashFromSidebarCommand}" />
                  <MenuItem Header="{Binding Loc.CopyEmailMenu}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding AccountsVm.CopyEmailCommand}" />
                  <MenuItem Header="{Binding Loc.BuyMoreStorageButton}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding AccountsVm.BuyMoreStorageCommand}" />
                  <Separator IsVisible="{Binding AccountsVm.IsConnected}" />
                  <MenuItem Header="{Binding Loc.DisconnectButton}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding AccountsVm.DisconnectCommand}" />
                </ContextMenu>
              </Border.ContextMenu>

              <StackPanel Spacing="10">
                <!-- Account identity row -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                    <Ellipse Width="36"
                             Height="36"
                             Fill="{DynamicResource M3SecondaryContainer}"
                             IsVisible="{Binding !HasAccountAvatar}" />
                    <PathIcon Width="16"
                              Height="16"
                              Foreground="{DynamicResource M3Primary}"
                              IsVisible="{Binding !HasAccountAvatar}"
                              Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                    <Ellipse Width="36"
                             Height="36"
                             Stroke="{DynamicResource M3OutlineVariant}"
                             StrokeThickness="1"
                             IsVisible="{Binding HasAccountAvatar}">
                      <Ellipse.Fill>
                        <ImageBrush Source="{Binding AccountAvatarBitmap}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                      </Ellipse.Fill>
                    </Ellipse>
                  </Grid>

                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource M3OnSurface}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding AccountsVm.DisplayName}" />
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource M3OnSurfaceVariant}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding AccountsVm.EmailAddress}" />
                  </StackPanel>

                  <Button Grid.Column="2"
                          Classes="m3-tonal m3-icon"
                          VerticalAlignment="Center"
                          IsVisible="{Binding AccountsVm.IsConnected}"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          ToolTip.Tip="{Binding Loc.AddAccountMenu}"
                          Command="{Binding AccountsVm.AddAccountCommand}">
                    <PathIcon Width="12" Height="12" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                  </Button>
                </Grid>

                <!-- Connected account switcher -->
                <ComboBox HorizontalAlignment="Stretch"
                          FontSize="11.5"
                          IsVisible="{Binding AccountsVm.HasMultipleAccounts}"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          ItemsSource="{Binding AccountsVm.SavedAccounts}"
                          SelectedIndex="{Binding AccountsVm.SelectedAccountIndex}"
                          ToolTip.Tip="{Binding Loc.SwitchAccountLabel}" />

                <!-- Account actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding AccountsVm.IsConnected}">
                  <Button Grid.Column="0"
                          Classes="m3-outlined m3-compact"
                          Padding="8,4"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          Command="{Binding AccountsVm.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Width="11"
                                Height="11"
                                IsVisible="{Binding AccountsVm.ShowDefaultRefreshIcon}"
                                Foreground="{DynamicResource M3OnSurface}"
                                Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                      <PathIcon Width="11"
                                Height="11"
                                Classes="m3-spinning"
                                IsVisible="{Binding AccountsVm.IsRefreshingQuota}"
                                Foreground="{DynamicResource M3Primary}"
                                Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z">
                        <PathIcon.RenderTransform>
                          <RotateTransform />
                        </PathIcon.RenderTransform>
                      </PathIcon>
                      <PathIcon Width="11"
                                Height="11"
                                IsVisible="{Binding AccountsVm.IsQuotaRefreshed}"
                                Foreground="{DynamicResource M3Success}"
                                Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                      <TextBlock FontSize="11" Text="{Binding Loc.RefreshButton}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="1"
                          Classes="m3-danger-outlined m3-compact"
                          Padding="8,4"
                          FontSize="11"
                          HorizontalAlignment="Stretch"
                          Content="{Binding Loc.DisconnectButton}"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          Command="{Binding AccountsVm.DisconnectCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding !AccountsVm.IsConnected}">
                  <Button Grid.Column="0"
                          Classes="m3-outlined m3-compact"
                          Padding="8,4"
                          FontSize="11"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          Content="{Binding Loc.ImportJsonShortButton}"
                          Command="{Binding AccountsVm.ImportCredentialsCommand}" />
                  <Button Grid.Column="1"
                          Classes="m3-filled m3-compact"
                          Padding="8,4"
                          FontSize="11"
                          HorizontalAlignment="Stretch"
                          Content="{Binding Loc.ConnectShortButton}"
                          Command="{Binding AccountsVm.ConnectCommand}" />
                </Grid>

                <Button Classes="m3-danger-outlined m3-compact"
                        Padding="8,4"
                        FontSize="11"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding AccountsVm.IsConnecting}"
                        Content="{Binding Loc.CancelAuthButton}"
                        Command="{Binding AccountsVm.CancelConnectCommand}" />

                <!-- Quick add-account prompt -->
                <Border Background="{DynamicResource M3SurfaceContainer}"
                        CornerRadius="12"
                        BorderThickness="0"
                        Padding="10"
                        IsVisible="{Binding AccountsVm.IsAddAccountPromptVisible}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource M3OnSurface}"
                                 VerticalAlignment="Center"
                                 Text="{Binding Loc.AddAccountPromptTitle}" />
                      <Button Grid.Column="1"
                              Classes="m3-text m3-icon"
                              Padding="4"
                              FontSize="10"
                              Content="✕"
                              Command="{Binding AccountsVm.CancelAddAccountPromptCommand}" />
                    </Grid>
                    <Button Classes="m3-filled m3-compact"
                            FontSize="11"
                            HorizontalAlignment="Stretch"
                            Content="{Binding Loc.AddAccountImportNewJson}"
                            Command="{Binding AccountsVm.ImportJsonAndAddAccountCommand}" />
                    <Button Classes="m3-tonal m3-compact"
                            FontSize="11"
                            HorizontalAlignment="Stretch"
                            Content="{Binding Loc.AddAccountUseCurrentJson}"
                            Command="{Binding AccountsVm.ContinueWithCurrentJsonCommand}" />
                  </StackPanel>
                </Border>

                <!-- Disconnect confirmation prompt -->
                <Border Background="{DynamicResource M3ErrorContainer}"
                        CornerRadius="12"
                        BorderThickness="0"
                        Padding="10"
                        IsVisible="{Binding AccountsVm.IsDisconnectPromptVisible}">
                  <StackPanel Spacing="6">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource M3OnErrorContainer}"
                               TextWrapping="Wrap"
                               Text="{Binding Loc.SidebarDisconnectPromptTitle}" />
                    <CheckBox FontSize="11"
                              IsChecked="{Binding AccountsVm.DeleteFoldersOnDisconnect}"
                              Content="{Binding Loc.SidebarDeleteFoldersCheckbox}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                      <Button Grid.Column="0"
                              Classes="m3-outlined m3-compact"
                              FontSize="11"
                              HorizontalAlignment="Stretch"
                              Content="{Binding Loc.CancelButton}"
                              Command="{Binding AccountsVm.CancelDisconnectCommand}" />
                      <Button Grid.Column="1"
                              Classes="m3-danger-tonal m3-compact"
                              FontSize="11"
                              HorizontalAlignment="Stretch"
                              Content="{Binding Loc.ConfirmButton}"
                              Command="{Binding AccountsVm.ConfirmDisconnectCommand}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Segmented storage bar and service breakdown -->
                <StackPanel Spacing="6" IsVisible="{Binding AccountsVm.IsConnected}">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="m3-meta" FontSize="10.5" Text="{Binding Loc.StorageLabel}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding AccountsVm.ShortQuotaText}" />
                  </StackPanel>

                  <Border Height="6"
                          CornerRadius="4"
                          Background="{DynamicResource M3SurfaceContainerHighest}"
                          ClipToBounds="True"
                          HorizontalAlignment="Stretch"
                          SizeChanged="OnSidebarStorageBarSizeChanged">
                    <StackPanel Orientation="Horizontal" Spacing="1">
                      <Border Background="{DynamicResource M3Primary}" Width="{Binding AccountsVm.DriveBarWidth}" Height="6" />
                      <Border Background="{DynamicResource M3Tertiary}" Width="{Binding AccountsVm.OtherBarWidth}" Height="6" />
                      <Border Background="{DynamicResource M3StorageTrash}" Width="{Binding AccountsVm.TrashBarWidth}" Height="6" />
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource M3Primary}" VerticalAlignment="Center" />
                      <TextBlock Classes="m3-meta" FontSize="11" Text="{Binding AccountsVm.DriveLegendText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource M3Tertiary}" VerticalAlignment="Center" />
                      <TextBlock Classes="m3-meta" FontSize="11" Text="{Binding AccountsVm.OtherLegendText}" />
                    </StackPanel>
                    <Button Classes="m3-text"
                            MinHeight="0"
                            Padding="0,2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="{Binding Loc.OpenTrashTooltip}"
                            Command="{Binding OpenTrashFromSidebarCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource M3StorageTrash}" VerticalAlignment="Center" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource M3Error}" Text="{Binding AccountsVm.TrashLegendText}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <Button Classes="m3-tonal m3-compact"
                          FontSize="11"
                          HorizontalAlignment="Stretch"
                          Content="{Binding Loc.BuyMoreStorageButton}"
                          Command="{Binding AccountsVm.BuyMoreStorageCommand}" />
                </StackPanel>

                <!-- Sync status indicator -->
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="m3-spinning"
                              Width="12" Height="12"
                              Foreground="{DynamicResource M3Primary}"
                              IsVisible="{Binding IsSidebarGenericSyncing}"
                              Data="{StaticResource TundraRefreshGeometry}">
                      <PathIcon.RenderTransform>
                        <RotateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <PathIcon Classes="m3-upload-pulse"
                              Width="12" Height="12"
                              Foreground="{DynamicResource M3Primary}"
                              IsVisible="{Binding IsSidebarUploading}"
                              Data="{StaticResource TundraUploadGeometry}">
                      <PathIcon.RenderTransform>
                        <TranslateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <PathIcon Classes="m3-download-pulse"
                              Width="12" Height="12"
                              Foreground="{DynamicResource M3Success}"
                              IsVisible="{Binding IsSidebarDownloading}"
                              Data="{StaticResource TundraDownloadGeometry}">
                      <PathIcon.RenderTransform>
                        <TranslateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <PathIcon Classes="m3-delete-pulse"
                              Width="12" Height="12"
                              Foreground="{DynamicResource M3ErrorAccent}"
                              IsVisible="{Binding IsSidebarDeleting}"
                              Data="{StaticResource TundraTrashGeometry}">
                      <PathIcon.RenderTransform>
                        <TranslateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <PathIcon Classes="m3-error-pulse"
                              Width="12" Height="12"
                              Foreground="{DynamicResource M3ErrorAccent}"
                              IsVisible="{Binding IsSidebarError}"
                              Data="{StaticResource TundraAlertGeometry}">
                      <PathIcon.RenderTransform>
                        <TranslateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <TextBlock Classes="m3-meta" FontSize="11" Text="{Binding SidebarSyncStatusText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <ProgressBar Height="3"
                               CornerRadius="2"
                               IsIndeterminate="True"
                               Foreground="{Binding SidebarSyncAccentBrush}"
                               IsVisible="{Binding IsSyncActive}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Repository link -->
            <Button Classes="m3-text m3-compact"
                    Command="{Binding OpenRepositoryCommand}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="https://github.com/TundraLab/Custodia">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Width="16"
                          Height="16"
                          Foreground="{DynamicResource M3OnSurfaceVariant}"
                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                <TextBlock FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource M3OnSurfaceVariant}"
                           VerticalAlignment="Center"
                           Text="TundraLab/Custodia"
                           IsVisible="{Binding !IsSidebarCompact}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main content area -->
      <Grid Grid.Column="1"
            RowDefinitions="Auto,*"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Grid.Row="0"
                MinHeight="48"
                Background="{DynamicResource M3SecondaryContainer}"
                BorderThickness="0"
                Padding="20,8"
                IsVisible="{Binding IsUpdateBannerVisible}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <PathIcon Width="15"
                        Height="15"
                        Foreground="{DynamicResource M3Primary}"
                        Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
              <TextBlock FontSize="12.5"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource M3OnSecondaryContainer}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Text="{Binding UpdateBannerText}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="m3-filled m3-compact"
                    Content="{Binding Loc.UpdateBannerActionButton}"
                    Command="{Binding OpenUpdatesFromBannerCommand}" />
            <Button Grid.Column="2"
                    Classes="m3-text m3-icon"
                    Content="✕"
                    Command="{Binding DismissUpdateBannerCommand}" />
          </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding CurrentViewModel}" />
      </Grid>
    </Grid>
    </LayoutTransformControl>

    <!-- First-run Privacy and Terms acceptance modal -->
    <Border IsVisible="{Binding IsLegalConsentVisible}"
            Background="{DynamicResource M3ModalScrim}"
            Padding="24"
            ZIndex="100">
      <Border Classes="m3-dialog"
              MaxWidth="680"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="22">
        <ScrollViewer MaxHeight="580"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image Source="{DynamicResource TundraShieldVaultDrawing}" Width="28" Height="28" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource M3OnSurface}"
                           TextWrapping="Wrap"
                           Text="{Binding Loc.LegalConsentTitle}" />
                <TextBlock Classes="m3-meta"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Text="{Binding Loc.LegalConsentSubtitle}" />
              </StackPanel>
            </StackPanel>

            <Border Classes="m3-card" Padding="16,12">
              <StackPanel Spacing="8">
                <TextBlock FontSize="12.5" Foreground="{DynamicResource M3OnSurface}" TextWrapping="Wrap" Text="{Binding Loc.LegalConsentDriveScopeBullet}" />
                <TextBlock FontSize="12.5" Foreground="{DynamicResource M3OnSurface}" TextWrapping="Wrap" Text="{Binding Loc.LegalConsentLocalDataBullet}" />
                <TextBlock FontSize="12.5" Foreground="{DynamicResource M3OnSurface}" TextWrapping="Wrap" Text="{Binding Loc.LegalConsentEmailBullet}" />
              </StackPanel>
            </Border>

            <WrapPanel Orientation="Horizontal">
              <Button Classes="m3-outlined m3-compact"
                      Margin="0,0,8,4"
                      Content="{Binding Loc.LegalPrivacyButton}"
                      Command="{Binding OpenPrivacyPolicyCommand}" />
              <Button Classes="m3-outlined m3-compact"
                      Margin="0,0,8,4"
                      Content="{Binding Loc.LegalTermsButton}"
                      Command="{Binding OpenTermsOfUseCommand}" />
              <Button Classes="m3-outlined m3-compact"
                      Margin="0,0,0,4"
                      Content="{Binding Loc.LegalGooglePolicyButton}"
                      Command="{Binding OpenGoogleApiPolicyCommand}" />
            </WrapPanel>

            <StackPanel Spacing="8">
              <CheckBox IsChecked="{Binding LegalTermsAccepted, Mode=TwoWay}">
                <TextBlock FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource M3OnSurface}"
                           TextWrapping="Wrap"
                           Text="{Binding Loc.LegalConsentAcceptCheckbox}" />
              </CheckBox>

              <CheckBox IsChecked="{Binding LegalLifecycleEmailOptIn, Mode=TwoWay}">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource M3OnSurfaceVariant}"
                           TextWrapping="Wrap"
                           Text="{Binding Loc.LegalConsentEmailOptInCheckbox}" />
              </CheckBox>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Column="0"
                         Classes="m3-meta"
                         FontSize="11.5"
                         VerticalAlignment="Center"
                         Text="TundraLab • contato.tundralab@gmail.com" />
              <Button Grid.Column="1"
                      Classes="m3-filled"
                      Content="{Binding Loc.LegalConsentContinueButton}"
                      Command="{Binding AcceptLegalConsentCommand}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>
</Window>

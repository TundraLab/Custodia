<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TundraDrive.Desktop.ViewModels"
        x:Class="TundraDrive.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Loc.WindowTitle}"
        Icon="avares://Custodia/Assets/custodia-icon.png"
        Width="1120"
        Height="740"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TundraWindowBg}">

  <LayoutTransformControl x:Name="RootLayoutTransform"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding UiScaleFactor}" ScaleY="{Binding UiScaleFactor}" />
    </LayoutTransformControl.LayoutTransform>

    <Grid ColumnDefinitions="Auto,*"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
    <!-- Barra lateral -->
    <Border Grid.Column="0"
            Width="{Binding SidebarWidth}"
            Background="{StaticResource TundraSidebarBg}"
            BorderBrush="{StaticResource TundraBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="10,14">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,0,4,16">
          <StackPanel Grid.Column="0" Spacing="3" IsVisible="{Binding !IsSidebarCompact}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Image Source="avares://Custodia/Assets/custodia-icon.png" Width="22" Height="22" />
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Custódia" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="MutedMeta" Text="{Binding Loc.BrandSubtitle}" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <Button Grid.Column="1"
                  Command="{Binding ToggleSidebarCompactCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="6"
                  Cursor="Hand"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Center">
            <PathIcon Width="14" Height="14"
                      Foreground="{StaticResource TundraTextSecondary}"
                      Data="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ListBox Classes="NavList"
                   SelectedIndex="{Binding SelectedNavigationIndex}">
          <ListBoxItem ToolTip.Tip="{Binding Loc.NavFileHub}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Width="15" Height="15"
                        Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z" />
              <TextBlock FontSize="13.5" Text="{Binding Loc.NavFileHub}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem ToolTip.Tip="{Binding Loc.NavSyncFolders}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Width="15" Height="15"
                        Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
              <TextBlock FontSize="13.5" Text="{Binding Loc.NavSyncFolders}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem ToolTip.Tip="{Binding Loc.NavTransferQueue}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Width="15" Height="15"
                        Data="M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z" />
              <TextBlock FontSize="13.5" Text="{Binding Loc.NavTransferQueue}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem ToolTip.Tip="{Binding Loc.NavActivityLogs}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Width="15" Height="15"
                        Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" />
              <TextBlock FontSize="13.5" Text="{Binding Loc.NavActivityLogs}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem ToolTip.Tip="{Binding Loc.NavSettings}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Width="15" Height="15"
                        Data="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
              <TextBlock FontSize="13.5" Text="{Binding Loc.NavSettings}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem ToolTip.Tip="{Binding Loc.NavAbout}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Width="15" Height="15"
                        Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
              <TextBlock FontSize="13.5" Text="{Binding Loc.NavAbout}" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCompact}" />
            </StackPanel>
          </ListBoxItem>
          </ListBox>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource TundraBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="4,10,4,0">
          <StackPanel Spacing="10">
            <!-- Avatar compacto quando sidebar recolhida -->
            <Grid Width="30"
                  Height="30"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsSidebarCompact}"
                  ToolTip.Tip="{Binding AccountsVm.EmailAddress}">
              <Ellipse Width="30" Height="30" Fill="#252B36" Stroke="{StaticResource TundraBorderBrush}" StrokeThickness="1" IsVisible="{Binding !HasAccountAvatar}" />
              <PathIcon Width="14" Height="14" Foreground="{StaticResource TundraTextSecondary}" IsVisible="{Binding !HasAccountAvatar}" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
              <Ellipse Width="30" Height="30" Stroke="{StaticResource TundraBorderBrush}" StrokeThickness="1" IsVisible="{Binding HasAccountAvatar}">
                <Ellipse.Fill>
                  <ImageBrush Source="{Binding AccountAvatarBitmap}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Ellipse.Fill>
              </Ellipse>
            </Grid>

            <!-- Cartão organizado de Conta + Armazenamento -->
            <Border Background="{StaticResource TundraCardBg}"
                    BorderBrush="{StaticResource TundraBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    IsVisible="{Binding !IsSidebarCompact}">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding Loc.AddAccountMenu}"
                            Command="{Binding AccountsVm.AddAccountCommand}" />
                  <MenuItem Header="{Binding Loc.CredentialsAccountsSectionTitle}"
                            Command="{Binding OpenAccountSettingsCommand}" />
                  <MenuItem Header="{Binding Loc.RefreshQuotaButton}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding AccountsVm.RefreshCommand}" />
                  <MenuItem Header="{Binding Loc.OpenTrashTooltip}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding OpenTrashFromSidebarCommand}" />
                  <MenuItem Header="{Binding Loc.CopyEmailMenu}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding AccountsVm.CopyEmailCommand}" />
                  <MenuItem Header="{Binding Loc.BuyMoreStorageButton}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding AccountsVm.BuyMoreStorageCommand}" />
                  <Separator IsVisible="{Binding AccountsVm.IsConnected}" />
                  <MenuItem Header="{Binding Loc.DisconnectButton}"
                            IsVisible="{Binding AccountsVm.IsConnected}"
                            Command="{Binding AccountsVm.DisconnectCommand}" />
                </ContextMenu>
              </Border.ContextMenu>

              <StackPanel Spacing="9">
                <!-- Avatar circular + Nome + E-mail + Botão Adicionar Conta -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                    <Ellipse Width="36" Height="36" Fill="#252B36" Stroke="{StaticResource TundraBorderBrush}" StrokeThickness="1" IsVisible="{Binding !HasAccountAvatar}" />
                    <PathIcon Width="16" Height="16"
                              Foreground="{StaticResource TundraAccent}"
                              IsVisible="{Binding !HasAccountAvatar}"
                              Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                    <Ellipse Width="36" Height="36" Stroke="{StaticResource TundraBorderBrush}" StrokeThickness="1" IsVisible="{Binding HasAccountAvatar}">
                      <Ellipse.Fill>
                        <ImageBrush Source="{Binding AccountAvatarBitmap}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                      </Ellipse.Fill>
                    </Ellipse>
                  </Grid>

                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TundraTextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding AccountsVm.DisplayName}" />
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource TundraTextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding AccountsVm.EmailAddress}" />
                  </StackPanel>

                  <Button Grid.Column="2"
                          Classes="SecondaryAction"
                          Padding="6,5"
                          VerticalAlignment="Center"
                          IsVisible="{Binding AccountsVm.IsConnected}"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          ToolTip.Tip="{Binding Loc.AddAccountMenu}"
                          Command="{Binding AccountsVm.AddAccountCommand}">
                    <PathIcon Width="12" Height="12" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                  </Button>
                </Grid>

                <!-- Alternador de contas conectadas -->
                <ComboBox HorizontalAlignment="Stretch"
                          FontSize="11.5"
                          IsVisible="{Binding AccountsVm.HasMultipleAccounts}"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          ItemsSource="{Binding AccountsVm.SavedAccounts}"
                          SelectedIndex="{Binding AccountsVm.SelectedAccountIndex}"
                          ToolTip.Tip="{Binding Loc.SwitchAccountLabel}" />

                <!-- Botões da conta -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding AccountsVm.IsConnected}">
                  <Button Grid.Column="0"
                          Classes="SecondaryAction"
                          Padding="6,4"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          Command="{Binding AccountsVm.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Width="11" Height="11"
                                IsVisible="{Binding AccountsVm.ShowDefaultRefreshIcon}"
                                Foreground="{StaticResource TundraTextPrimary}"
                                Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                      <PathIcon Width="11" Height="11"
                                Classes="Spinning"
                                IsVisible="{Binding AccountsVm.IsRefreshingQuota}"
                                Foreground="{StaticResource TundraAccent}"
                                Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z">
                        <PathIcon.RenderTransform>
                          <RotateTransform />
                        </PathIcon.RenderTransform>
                      </PathIcon>
                      <PathIcon Width="11" Height="11"
                                IsVisible="{Binding AccountsVm.IsQuotaRefreshed}"
                                Foreground="#34D399"
                                Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                      <TextBlock FontSize="11" Text="{Binding Loc.RefreshButton}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="1"
                          Classes="DangerAction"
                          Padding="6,4"
                          FontSize="11"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          Content="{Binding Loc.DisconnectButton}"
                          Command="{Binding AccountsVm.DisconnectCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding !AccountsVm.IsConnected}">
                  <Button Grid.Column="0"
                          Classes="SecondaryAction"
                          Padding="6,4"
                          FontSize="11"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          IsEnabled="{Binding !AccountsVm.IsBusy}"
                          Content="{Binding Loc.ImportJsonShortButton}"
                          Command="{Binding AccountsVm.ImportCredentialsCommand}" />
                  <Button Grid.Column="1"
                          Classes="PrimaryAction"
                          Padding="6,4"
                          FontSize="11"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Content="{Binding Loc.ConnectShortButton}"
                          Command="{Binding AccountsVm.ConnectCommand}" />
                </Grid>

                <Button Classes="DangerAction"
                        Padding="6,4"
                        FontSize="11"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsVisible="{Binding AccountsVm.IsConnecting}"
                        Content="{Binding Loc.CancelAuthButton}"
                        Command="{Binding AccountsVm.CancelConnectCommand}" />

                <!-- Escolha rápida ao clicar em "+" -->
                <Border Background="#121722"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        IsVisible="{Binding AccountsVm.IsAddAccountPromptVisible}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Loc.AddAccountPromptTitle}" />
                      <Button Grid.Column="1" Classes="SecondaryAction" Padding="5,1" FontSize="10" Content="✕" Command="{Binding AccountsVm.CancelAddAccountPromptCommand}" />
                    </Grid>
                    <Button Classes="PrimaryAction"
                            Padding="6,4"
                            FontSize="11"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="{Binding Loc.AddAccountImportNewJson}"
                            Command="{Binding AccountsVm.ImportJsonAndAddAccountCommand}" />
                    <Button Classes="SecondaryAction"
                            Padding="6,4"
                            FontSize="11"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="{Binding Loc.AddAccountUseCurrentJson}"
                            Command="{Binding AccountsVm.ContinueWithCurrentJsonCommand}" />
                  </StackPanel>
                </Border>

                <!-- Confirmação de desconexão na barra lateral -->
                <Border Background="#2A1215"
                        BorderBrush="#991B1B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        IsVisible="{Binding AccountsVm.IsDisconnectPromptVisible}">
                  <StackPanel Spacing="6">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FECACA"
                               TextWrapping="Wrap"
                               Text="{Binding Loc.SidebarDisconnectPromptTitle}" />
                    <CheckBox FontSize="11"
                              IsChecked="{Binding AccountsVm.DeleteFoldersOnDisconnect}"
                              Content="{Binding Loc.SidebarDeleteFoldersCheckbox}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                      <Button Grid.Column="0"
                              Classes="SecondaryAction"
                              Padding="6,4"
                              FontSize="11"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Content="{Binding Loc.CancelButton}"
                              Command="{Binding AccountsVm.CancelDisconnectCommand}" />
                      <Button Grid.Column="1"
                              Classes="DangerAction"
                              Padding="6,4"
                              FontSize="11"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Content="{Binding Loc.ConfirmButton}"
                              Command="{Binding AccountsVm.ConfirmDisconnectCommand}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Armazenamento segmentado + consumo por serviço -->
                <StackPanel Spacing="6" IsVisible="{Binding AccountsVm.IsConnected}">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="MutedMeta" FontSize="10.5" Text="{Binding Loc.StorageLabel}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TundraTextPrimary}" Text="{Binding AccountsVm.ShortQuotaText}" />
                  </StackPanel>

                  <Border Height="6"
                          CornerRadius="3"
                          Background="#252B36"
                          ClipToBounds="True"
                          HorizontalAlignment="Stretch"
                          SizeChanged="OnSidebarStorageBarSizeChanged">
                    <StackPanel Orientation="Horizontal" Spacing="1">
                      <Border Background="#3B82F6" Width="{Binding AccountsVm.DriveBarWidth}" Height="6" />
                      <Border Background="#22D3EE" Width="{Binding AccountsVm.OtherBarWidth}" Height="6" />
                      <Border Background="#64748B" Width="{Binding AccountsVm.TrashBarWidth}" Height="6" />
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="7" Height="7" CornerRadius="4" Background="#3B82F6" VerticalAlignment="Center" />
                      <TextBlock Classes="MutedMeta" FontSize="11" Text="{Binding AccountsVm.DriveLegendText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="7" Height="7" CornerRadius="4" Background="#22D3EE" VerticalAlignment="Center" />
                      <TextBlock Classes="MutedMeta" FontSize="11" Text="{Binding AccountsVm.OtherLegendText}" />
                    </StackPanel>
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding Loc.OpenTrashTooltip}"
                            Command="{Binding OpenTrashFromSidebarCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="7" Height="7" CornerRadius="4" Background="#64748B" VerticalAlignment="Center" />
                        <TextBlock FontSize="11" Foreground="#FCA5A5" Text="{Binding AccountsVm.TrashLegendText}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <Button Classes="SecondaryAction"
                          Padding="8,4"
                          FontSize="11"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Content="{Binding Loc.BuyMoreStorageButton}"
                          Command="{Binding AccountsVm.BuyMoreStorageCommand}" />
                </StackPanel>

                <!-- Status de sincronização -->
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="Spinning"
                              Width="12" Height="12"
                              Foreground="{StaticResource TundraAccent}"
                              IsVisible="{Binding IsSidebarGenericSyncing}"
                              Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z">
                      <PathIcon.RenderTransform>
                        <RotateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <PathIcon Classes="UploadPulse"
                              Width="12" Height="12"
                              Foreground="#3B82F6"
                              IsVisible="{Binding IsSidebarUploading}"
                              Data="M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z">
                      <PathIcon.RenderTransform>
                        <TranslateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <PathIcon Classes="DownloadPulse"
                              Width="12" Height="12"
                              Foreground="#2EA043"
                              IsVisible="{Binding IsSidebarDownloading}"
                              Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z">
                      <PathIcon.RenderTransform>
                        <TranslateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <PathIcon Classes="DeletePulse"
                              Width="12" Height="12"
                              Foreground="#EF4444"
                              IsVisible="{Binding IsSidebarDeleting}"
                              Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z">
                      <PathIcon.RenderTransform>
                        <TranslateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <PathIcon Classes="ErrorPulse"
                              Width="12" Height="12"
                              Foreground="#EF4444"
                              IsVisible="{Binding IsSidebarError}"
                              Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z">
                      <PathIcon.RenderTransform>
                        <TranslateTransform />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <TextBlock Classes="MutedMeta" FontSize="11" Text="{Binding SidebarSyncStatusText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <ProgressBar Height="2"
                               IsIndeterminate="True"
                               Foreground="{Binding SidebarSyncAccentBrush}"
                               IsVisible="{Binding IsSyncActive}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Link GitHub -->
            <Button Command="{Binding OpenRepositoryCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="6"
                    Padding="8,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Cursor="Hand"
                    ToolTip.Tip="https://github.com/TundraLab/Custodia">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Width="16" Height="16"
                          Foreground="#CBD5E1"
                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                <TextBlock FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="#CBD5E1"
                           VerticalAlignment="Center"
                           Text="TundraLab/Custodia"
                           IsVisible="{Binding !IsSidebarCompact}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

      <!-- Área de conteúdo -->
      <Grid Grid.Column="1"
            RowDefinitions="Auto,*"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Grid.Row="0"
                Background="#152338"
                BorderBrush="#2563EB"
                BorderThickness="0,0,0,1"
                Padding="18,9"
                IsVisible="{Binding IsUpdateBannerVisible}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <PathIcon Width="14" Height="14"
                        Foreground="#60A5FA"
                        Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
              <TextBlock FontSize="12.5"
                         FontWeight="SemiBold"
                         Foreground="#E2E8F0"
                         VerticalAlignment="Center"
                         Text="{Binding UpdateBannerText}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="PrimaryAction"
                    Padding="10,5"
                    FontSize="12"
                    Content="{Binding Loc.UpdateBannerActionButton}"
                    Command="{Binding OpenUpdatesFromBannerCommand}" />
            <Button Grid.Column="2"
                    Classes="SecondaryAction"
                    Padding="8,5"
                    FontSize="12"
                    Content="✕"
                    Command="{Binding DismissUpdateBannerCommand}" />
          </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding CurrentViewModel}" />
      </Grid>
    </Grid>
  </LayoutTransformControl>
</Window>

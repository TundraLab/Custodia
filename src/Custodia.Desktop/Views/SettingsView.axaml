<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Class="TundraDrive.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!-- Settings tab organized into focused GNOME/M3 inset grouped lists -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                AllowAutoHide="False">
    <StackPanel Margin="24,24,24,32"
                Spacing="22"
                MaxWidth="920"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
      <!-- Compact header toolbar -->
      <Grid MinHeight="48" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Classes="m3-page-title" VerticalAlignment="Center" Text="{Binding Loc.SettingsTitle}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border CornerRadius="14"
                  Padding="10,5"
                  Background="{DynamicResource M3SurfaceContainer}"
                  IsVisible="{Binding IsSaving}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13"
                        Classes="m3-spinning"
                        Foreground="{DynamicResource M3Primary}"
                        Data="{StaticResource TundraRefreshGeometry}">
                <PathIcon.RenderTransform>
                  <RotateTransform />
                </PathIcon.RenderTransform>
              </PathIcon>
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource M3OnSurfaceVariant}"
                         Text="{Binding Loc.SavingButton}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border CornerRadius="14"
                  Padding="10,5"
                  Background="{DynamicResource M3SurfaceContainer}"
                  IsVisible="{Binding IsSavedFeedback}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13"
                        Foreground="{DynamicResource M3Success}"
                        Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource M3Success}"
                         Text="{Binding Loc.AutoSavedLabel}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- M3 segmented category bar -->
      <Border Classes="m3-segmented-track" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="m3-segmented"
                  Classes.m3-seg-active="{Binding IsGeneralTab}"
                  Content="{Binding Loc.SettingsTabGeneral}"
                  Command="{Binding SelectGeneralTabCommand}" />
          <Button Classes="m3-segmented"
                  Classes.m3-seg-active="{Binding IsAccountsTab}"
                  Content="{Binding Loc.SettingsTabAccounts}"
                  Command="{Binding SelectAccountsTabCommand}" />
          <Button Classes="m3-segmented"
                  Classes.m3-seg-active="{Binding IsSyncTab}"
                  Content="{Binding Loc.SettingsTabSync}"
                  Command="{Binding SelectSyncTabCommand}" />
          <Button Classes="m3-segmented"
                  Classes.m3-seg-active="{Binding IsApiTab}"
                  Content="{Binding Loc.SettingsTabApi}"
                  Command="{Binding SelectApiTabCommand}" />
        </StackPanel>
      </Border>

      <!-- TAB 1: General (Appearance, System, Notifications, Downloads & Memory) -->
      <StackPanel Spacing="22" IsVisible="{Binding IsGeneralTab}">
      <!-- 1. Appearance & Language -->
      <StackPanel Spacing="8">
        <TextBlock Classes="m3-group-label" Margin="4,0,0,0" Text="{Binding Loc.AppearanceSectionTitle}" />

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.LanguageLabel}" TextWrapping="Wrap" />
                  <TextBlock Classes="m3-meta" Text="{Binding Loc.LanguageHint}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="220"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedIndex="{Binding SelectedLanguageIndex}" />
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.UiThemeLabel}" TextWrapping="Wrap" />
                  <TextBlock Classes="m3-meta" Text="{Binding Loc.UiThemeHint}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="220"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedIndex="{Binding SelectedThemeIndex}" />
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.UiAccentLabel}" TextWrapping="Wrap" />
                  <TextBlock Classes="m3-meta" Text="{Binding Loc.UiAccentHint}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="220"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AccentOptions}"
                          SelectedIndex="{Binding SelectedAccentIndex}" />
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.UiScaleLabel}" TextWrapping="Wrap" />
                  <TextBlock Classes="m3-meta" Text="{Binding Loc.UiScaleHint}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Slider Width="140"
                          Minimum="100"
                          Maximum="300"
                          TickFrequency="25"
                          IsSnapToTickEnabled="True"
                          Value="{Binding UiScalePercent}" />
                  <TextBlock Width="44"
                             FontSize="12.5"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource M3OnSurface}"
                             VerticalAlignment="Center"
                             Text="{Binding UiScaleDisplay}" />
                  <Button Classes="m3-tonal m3-compact"
                          Content="100%"
                          Command="{Binding ResetUiScaleCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 2. System & Updates -->
      <StackPanel Spacing="8">
        <TextBlock Classes="m3-group-label" Margin="4,0,0,0" Text="{Binding Loc.SystemBehaviorSectionTitle}" />

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding StartOnBoot}"
                          IsEnabled="{Binding IsAutostartSupported}"
                          Content="{Binding Loc.StartOnBootCheckbox}" />
                <TextBlock Classes="m3-meta" Margin="28,0,0,0" Text="{Binding Loc.StartOnBootHint}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <CheckBox IsChecked="{Binding MinimizeToTrayOnClose}"
                        Content="{Binding Loc.MinimizeToTrayCheckbox}" />
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="8">
                <CheckBox IsChecked="{Binding AutoCheckUpdates}"
                          Content="{Binding Loc.AutoCheckUpdatesCheckbox}" />
                <TextBlock Classes="m3-meta" Margin="28,0,0,0" Text="{Binding Loc.AutoCheckUpdatesHint}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="28,2,0,0" IsEnabled="{Binding AutoCheckUpdates}">
                  <TextBlock Grid.Column="0" FontSize="12.5" VerticalAlignment="Center" Classes="m3-meta" Text="{Binding Loc.UpdateFrequencyLabel}" />
                  <ComboBox Grid.Column="1"
                            Width="235"
                            ItemsSource="{Binding UpdateFrequencies}"
                            SelectedIndex="{Binding SelectedUpdateFrequencyIndex}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 3. Notifications -->
      <StackPanel Spacing="8">
        <TextBlock Classes="m3-group-label" Margin="4,0,0,0" Text="{Binding Loc.NotificationsSectionTitle}" />

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding NotificationsEnabled}"
                          Content="{Binding Loc.NotificationsEnabledCheckbox}" />
                <Button Grid.Column="1"
                        Classes="m3-tonal m3-compact"
                        Content="{Binding Loc.TestNotificationButton}"
                        Command="{Binding TestNotificationCommand}" />
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row" IsEnabled="{Binding NotificationsEnabled}">
              <StackPanel Spacing="8">
                <CheckBox IsChecked="{Binding NotificationSoundEnabled}"
                          Content="{Binding Loc.NotificationSoundCheckbox}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="28,0,0,0" IsEnabled="{Binding NotificationSoundEnabled}">
                  <TextBlock Grid.Column="0" FontSize="12.5" VerticalAlignment="Center" Classes="m3-meta" Text="{Binding Loc.NotificationSoundToneLabel}" />
                  <ComboBox Grid.Column="1"
                            Width="210"
                            ItemsSource="{Binding NotificationSoundOptions}"
                            SelectedIndex="{Binding SelectedNotificationSoundIndex}" />
                  <Button Grid.Column="2"
                          Classes="m3-outlined m3-compact"
                          Content="{Binding Loc.PreviewSoundButton}"
                          Command="{Binding PreviewNotificationSoundCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 4. Downloads & Memory -->
      <StackPanel Spacing="8">
        <TextBlock Classes="m3-group-label" Margin="4,0,0,0" Text="{Binding Loc.StoragePerformanceSectionTitle}" />

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="8">
                <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.DownloadDirectoryLabel}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0"
                           FontFamily="monospace"
                           FontSize="12"
                           Text="{Binding DownloadDirectory}" />
                  <Button Grid.Column="1"
                          Classes="m3-tonal"
                          Content="{Binding Loc.BrowseFolderButton}"
                          Command="{Binding BrowseDownloadDirectoryCommand}" />
                </Grid>
                <TextBlock Classes="m3-meta" Text="{Binding Loc.DownloadDirectoryHint}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding AutoMemoryCleanupEnabled}"
                            Content="{Binding Loc.AutoMemoryCleanupLabel}" />
                  <TextBlock Classes="m3-meta" Margin="28,0,0,0" Text="{Binding Loc.AutoMemoryCleanupHint}" TextWrapping="Wrap" />
                  <TextBlock Classes="m3-meta" Margin="28,2,0,0" FontSize="11.5" Foreground="{DynamicResource M3Primary}" Text="{Binding MemoryCleanerStatusText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsEnabled="{Binding AutoMemoryCleanupEnabled}">
                    <TextBlock Classes="m3-meta" VerticalAlignment="Center" Text="{Binding Loc.MemoryCleanupIntervalLabel}" />
                    <NumericUpDown Width="105"
                                   Minimum="1"
                                   Maximum="60"
                                   Increment="1"
                                   Value="{Binding MemoryCleanupIntervalMinutes}" />
                  </StackPanel>
                  <Button Classes="m3-tonal m3-compact"
                          IsEnabled="{Binding !IsCleaningMemory}"
                          Content="{Binding Loc.CleanMemoryNowButton}"
                          Command="{Binding CleanMemoryNowCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
      </StackPanel>

      <!-- TAB 2: OAuth Credentials & Connected Accounts -->
      <StackPanel Spacing="10" DragDrop.AllowDrop="True" IsVisible="{Binding IsAccountsTab}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4,0,0,0">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="m3-group-label" Text="{Binding Loc.CredentialsAccountsSectionTitle}" />
            <TextBlock Classes="m3-meta" FontSize="12" Text="{Binding Loc.CredentialsAccountsSubtitle}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="m3-outlined m3-compact"
                    Content="{Binding Loc.OpenAccountsFolderButton}"
                    Command="{Binding OpenAccountsRootFolderCommand}" />
            <Button Classes="m3-filled m3-compact"
                    Content="{Binding Loc.AddAccountShortButton}"
                    IsEnabled="{Binding !IsCredentialsBusy}"
                    Command="{Binding AddAccountFromSettingsCommand}" />
          </StackPanel>
        </Grid>

        <!-- Import / account feedback banner -->
        <Border Background="{Binding CredentialsFeedbackBgBrush}"
                BorderBrush="{Binding CredentialsFeedbackBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                IsVisible="{Binding HasCredentialsFeedback}">
          <TextBlock FontSize="12.5"
                     FontWeight="Medium"
                     Foreground="{Binding CredentialsFeedbackTextBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding CredentialsFeedbackMessage}" />
        </Border>

        <!-- Auto-detected Downloads client_secret JSON banner -->
        <Border Classes="m3-banner-info"
                CornerRadius="12"
                Padding="14,10"
                IsVisible="{Binding HasDetectedDownloadsJson}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSecondaryContainer}" Text="{Binding Loc.DetectedDownloadsTitle}" />
              <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Foreground="{DynamicResource M3OnSecondaryContainer}" Text="{Binding DetectedDownloadsSummary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="m3-filled m3-compact"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding !IsCredentialsBusy}"
                    Content="{Binding Loc.UseDetectedJsonButton}"
                    Command="{Binding ImportDetectedDownloadsJsonCommand}" />
          </Grid>
        </Border>

        <!-- Add-account method prompt -->
        <Border Classes="m3-card-elevated"
                CornerRadius="12"
                Padding="14,10"
                IsVisible="{Binding IsAddAccountPromptVisible}">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" VerticalAlignment="Center" Text="{Binding Loc.AddAccountPromptTitle}" />
            <Button Grid.Column="1" Classes="m3-filled m3-compact" Content="{Binding Loc.AddAccountImportNewJson}" Command="{Binding ImportJsonAndAddAccountFromSettingsCommand}" />
            <Button Grid.Column="2" Classes="m3-tonal m3-compact" Content="{Binding Loc.AddAccountUseCurrentJson}" Command="{Binding ContinueWithCurrentJsonFromSettingsCommand}" />
            <Button Grid.Column="3" Classes="m3-text m3-icon" Content="✕" Command="{Binding CancelAddAccountPromptFromSettingsCommand}" />
          </Grid>
        </Border>

        <!-- Account removal confirmation banner -->
        <Border Classes="m3-banner-error"
                CornerRadius="12"
                Padding="14,10"
                IsVisible="{Binding HasPendingAccountRemoval}">
          <StackPanel Spacing="8">
            <TextBlock FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource M3OnErrorContainer}"
                       TextWrapping="Wrap"
                       Text="{Binding PendingRemoveAccountPromptText}" />
            <CheckBox IsChecked="{Binding PendingRemoveDeleteFolders}"
                      Content="{Binding Loc.DeleteAccountFoldersCheckbox}" />
            <WrapPanel Orientation="Horizontal">
              <Button Classes="m3-danger-tonal m3-compact"
                      Margin="0,0,8,0"
                      Content="{Binding Loc.ConfirmRemoveAccountButton}"
                      Command="{Binding ConfirmRemoveAccountCommand}" />
              <Button Classes="m3-outlined m3-compact"
                      Content="{Binding Loc.CancelButton}"
                      Command="{Binding CancelRemoveAccountCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <!-- Global credentials.json row -->
            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="12"
                        Background="{DynamicResource M3SurfaceContainerHigh}"
                        BorderThickness="0"
                        VerticalAlignment="Center">
                  <Image Width="20" Height="20"
                         Source="{DynamicResource TundraShieldVaultDrawing}"
                         Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.CredentialsFileLabel}" />
                    <Border Background="{DynamicResource M3WarningContainer}"
                            CornerRadius="10"
                            Padding="8,2"
                            IsVisible="{Binding !HasCredentialsJson}">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnWarningContainer}" Text="{Binding CredentialsStatusBadgeText}" />
                    </Border>
                  </StackPanel>

                  <TextBlock Classes="m3-meta"
                             FontSize="11.5"
                             FontFamily="monospace"
                             Foreground="{DynamicResource M3Primary}"
                             IsVisible="{Binding HasCredentialsMetadata}"
                             Text="{Binding CredentialsMetadataText}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="m3-meta"
                             FontSize="11.5"
                             Text="{Binding Loc.CredentialsDragDropHint}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Classes="m3-outlined m3-compact"
                          Margin="0,0,6,4"
                          Content="{Binding Loc.OpenLocalFolderMenu}"
                          Command="{Binding OpenCredentialsFolderCommand}" />
                  <Button Classes="m3-tonal m3-compact"
                          Margin="0,0,6,4"
                          Content="{Binding Loc.ImportCredentialsButton}"
                          IsEnabled="{Binding !IsCredentialsBusy}"
                          Command="{Binding ImportCredentialsJsonCommand}" />
                  <Button Classes="m3-danger-outlined m3-compact"
                          Margin="0,0,0,4"
                          Content="{Binding Loc.RevokeJsonOnlyButton}"
                          IsEnabled="{Binding CanRevokeCredentialsJson}"
                          Command="{Binding RevokeCredentialsJsonCommand}" />
                </WrapPanel>
              </Grid>
            </Border>

            <!-- Empty connected accounts hint -->
            <StackPanel IsVisible="{Binding !HasConnectedAccounts}">
              <Border Classes="m3-divider" />
              <Border Classes="m3-grouped-row">
                <TextBlock Classes="m3-meta" Text="{Binding Loc.ConnectedAccountsEmptyHint}" />
              </Border>
            </StackPanel>

            <!-- Connected accounts list -->
            <ItemsControl ItemsSource="{Binding ConnectedAccounts}" IsVisible="{Binding HasConnectedAccounts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsAccountItemViewModel">
                  <StackPanel>
                    <Border Classes="m3-divider" />
                    <Border Classes="m3-grouped-row">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                          <Ellipse Width="38" Height="38" Fill="{DynamicResource M3SecondaryContainer}" IsVisible="{Binding !HasAvatar}" />
                          <PathIcon Width="16" Height="16"
                                    Foreground="{DynamicResource M3Primary}"
                                    IsVisible="{Binding !HasAvatar}"
                                    Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                          <Ellipse Width="38" Height="38" Stroke="{DynamicResource M3OutlineVariant}" StrokeThickness="1" IsVisible="{Binding HasAvatar}">
                            <Ellipse.Fill>
                              <ImageBrush Source="{Binding AvatarBitmap}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                            </Ellipse.Fill>
                          </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding DisplayName}" />
                            <Border CornerRadius="10" Padding="8,2" Background="{Binding JsonBadgeBgBrush}">
                              <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding JsonBadgeFgBrush}" Text="{Binding JsonBadgeText}" />
                            </Border>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsActive}">
                              <PathIcon Width="12" Height="12"
                                        Foreground="{DynamicResource M3Success}"
                                        Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                              <TextBlock FontSize="11.5"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource M3Success}"
                                         VerticalAlignment="Center"
                                         Text="{Binding ActiveBadgeText}" />
                            </StackPanel>
                          </StackPanel>
                          <TextBlock Classes="m3-meta" FontSize="12" Text="{Binding EmailAddress}" />
                          <TextBlock Classes="m3-meta" FontSize="11.5" Text="{Binding QuotaSummary}" />
                          <TextBlock Classes="m3-meta" FontSize="11" FontFamily="monospace" Text="{Binding JsonDetailText}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="m3-meta" FontSize="10.5" FontFamily="monospace" Text="{Binding AccountFolderDisplay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                          <Button Classes="m3-tonal m3-compact"
                                  Margin="0,0,6,4"
                                  IsVisible="{Binding CanSwitch}"
                                  Content="{Binding SwitchButtonText}"
                                  Command="{Binding SwitchCommand}" />
                          <Button Classes="m3-outlined m3-compact"
                                  Margin="0,0,6,4"
                                  Content="{Binding ReconnectButtonText}"
                                  Command="{Binding ReconnectCommand}" />
                          <Button Classes="m3-outlined m3-compact"
                                  Margin="0,0,6,4"
                                  Content="{Binding ReplaceJsonButtonText}"
                                  Command="{Binding ReplaceJsonCommand}" />
                          <Button Classes="m3-outlined m3-compact"
                                  Margin="0,0,6,4"
                                  Content="{Binding OpenFolderButtonText}"
                                  Command="{Binding OpenFolderCommand}" />
                          <Button Classes="m3-danger-outlined m3-compact"
                                  Margin="0,0,0,4"
                                  Content="{Binding RevokeButtonText}"
                                  Command="{Binding RevokeCommand}" />
                        </WrapPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- TAB 3: Sync Engine -->
      <StackPanel Spacing="8" IsVisible="{Binding IsSyncTab}">
        <TextBlock Classes="m3-group-label" Margin="4,0,0,0" Text="{Binding Loc.SyncEngineSectionTitle}" />

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.SyncIntervalLabel}" TextWrapping="Wrap" />
                  <TextBlock Classes="m3-meta" Text="{Binding Loc.SyncIntervalHint}" TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown Grid.Column="1"
                               Width="150"
                               Minimum="30"
                               Maximum="86400"
                               Increment="30"
                               Value="{Binding SyncIntervalSeconds}" />
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.ConflictPolicyLabel}" TextWrapping="Wrap" />
                  <TextBlock Classes="m3-meta" Text="{Binding Loc.ConflictPolicyHint}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="260"
                          ItemsSource="{Binding ConflictPolicies}"
                          SelectedIndex="{Binding SelectedConflictPolicyIndex}" />
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <CheckBox IsChecked="{Binding WatchLocalChanges}"
                        Content="{Binding Loc.WatchLocalChangesCheckbox}" />
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding LimitConcurrentTransfers}"
                            Content="{Binding Loc.LimitConcurrentTransfersCheckbox}" />
                  <TextBlock Classes="m3-meta"
                             Margin="28,0,0,0"
                             Text="{Binding Loc.LimitConcurrentTransfersHint}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding LimitConcurrentTransfers}">
                  <TextBlock Classes="m3-meta"
                             VerticalAlignment="Center"
                             Text="{Binding Loc.MaxConcurrentTransfersLabel}" />
                  <NumericUpDown Width="110"
                                 Minimum="1"
                                 Maximum="6"
                                 Increment="1"
                                 Value="{Binding MaxConcurrentTransfers}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding LimitTransferBandwidth}"
                            Content="{Binding Loc.LimitBandwidthCheckbox}" />
                  <TextBlock Classes="m3-meta"
                             Margin="28,0,0,0"
                             Text="{Binding Loc.LimitBandwidthHint}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding LimitTransferBandwidth}">
                  <TextBlock Classes="m3-meta"
                             VerticalAlignment="Center"
                             Text="{Binding Loc.MaxBandwidthKbpsLabel}" />
                  <NumericUpDown Width="130"
                                 Minimum="64"
                                 Maximum="102400"
                                 Increment="256"
                                 Value="{Binding MaxTransferBandwidthKbps}" />
                  <TextBlock Classes="m3-meta"
                             FontSize="11.5"
                             VerticalAlignment="Center"
                             Text="{Binding BandwidthSummaryDisplay}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="8">
                <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.IgnorePatternsLabel}" />
                <TextBox AcceptsReturn="True"
                         Height="110"
                         FontFamily="monospace"
                         FontSize="12"
                         Padding="12,10"
                         Text="{Binding IgnorePatternsText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- TAB 4: Local REST API -->
      <StackPanel Spacing="8" IsVisible="{Binding IsApiTab}">
        <TextBlock Classes="m3-group-label" Margin="4,0,0,0" Text="{Binding Loc.LocalApiSectionTitle}" />

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <Border Classes="m3-grouped-row">
              <CheckBox IsChecked="{Binding EmbeddedApiEnabled}"
                        Content="{Binding Loc.EnableLocalApiCheckbox}" />
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.LocalApiPortLabel}" TextWrapping="Wrap" />
                  <TextBlock Classes="m3-meta" Text="{Binding Loc.LocalApiPortHint}" TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown Grid.Column="1"
                               Width="150"
                               Minimum="1024"
                               Maximum="65535"
                               Value="{Binding EmbeddedApiPort}" />
              </Grid>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.CurrentApiStatusLabel}" />
                    <TextBlock Classes="m3-subtitle" FontSize="12.5" Text="{Binding ApiEndpointStatus}" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="m3-tonal m3-compact"
                            Content="{Binding Loc.OpenApiDocsButton}"
                            Command="{Binding OpenApiDocsCommand}" />
                    <Button Classes="m3-outlined m3-compact"
                            Content="{Binding Loc.OpenApiSpecButton}"
                            Command="{Binding OpenApiSpecCommand}" />
                  </StackPanel>
                </Grid>

                <Expander Header="{Binding Loc.ApiEndpointsExpanderTitle}"
                          HorizontalAlignment="Stretch"
                          IsExpanded="False">
                  <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/status" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/openapi.json" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/sync/trigger" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/files/search" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/files/list" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/files/trash" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/folders" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/upload" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/download" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/{id}/move" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/{id}/trash" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/{id}/restore" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="DELETE /api/v1/files/{id}" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,6,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/transfers" />
                    </Border>
                    <Border Background="{DynamicResource M3SurfaceContainerHigh}" CornerRadius="10" Padding="10,5" Margin="0,0,0,6">
                      <TextBlock Classes="m3-meta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/logs" />
                    </Border>
                  </WrapPanel>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

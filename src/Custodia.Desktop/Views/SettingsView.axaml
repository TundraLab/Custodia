<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Class="TundraDrive.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!-- Aba de configuração -->
  <ScrollViewer Padding="24"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                AllowAutoHide="False">
    <StackPanel Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Classes="PageTitle" VerticalAlignment="Center" Text="{Binding Loc.SettingsTitle}" />

        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="SecondaryAction"
                  Classes.ReloadSuccess="{Binding IsReloadedFeedback}"
                  Margin="0,0,8,4"
                  Command="{Binding ReloadSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13"
                        Classes.Spinning="{Binding IsReloading}"
                        IsVisible="{Binding !IsReloadedFeedback}"
                        Foreground="{StaticResource TundraTextPrimary}"
                        Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z">
                <PathIcon.RenderTransform>
                  <RotateTransform />
                </PathIcon.RenderTransform>
              </PathIcon>
              <PathIcon Width="13" Height="13"
                        IsVisible="{Binding IsReloadedFeedback}"
                        Foreground="#6EE7B7"
                        Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              <TextBlock Text="{Binding ReloadButtonText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="PrimaryAction"
                  Classes.SuccessAction="{Binding IsSavedFeedback}"
                  Margin="0,0,0,4"
                  Command="{Binding SaveSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13"
                        IsVisible="{Binding ShowDefaultSaveIcon}"
                        Foreground="#FFFFFF"
                        Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" />
              <PathIcon Width="13" Height="13"
                        Classes.Spinning="True"
                        IsVisible="{Binding IsSaving}"
                        Foreground="#FFFFFF"
                        Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z">
                <PathIcon.RenderTransform>
                  <RotateTransform />
                </PathIcon.RenderTransform>
              </PathIcon>
              <PathIcon Width="13" Height="13"
                        IsVisible="{Binding IsSavedFeedback}"
                        Foreground="#FFFFFF"
                        Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              <TextBlock Text="{Binding SaveButtonText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </Grid>

      <!-- Sistema e idioma -->
      <Border Classes="SurfaceCard">
        <StackPanel Spacing="14">
          <TextBlock Classes="SectionTitle" Text="{Binding Loc.GeneralSectionTitle}" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock FontSize="13" Text="{Binding Loc.LanguageLabel}" TextWrapping="Wrap" />
              <TextBlock Classes="MutedMeta" Text="{Binding Loc.LanguageHint}" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1"
                      Width="200"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedIndex="{Binding SelectedLanguageIndex}" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock FontSize="13" Text="{Binding Loc.UiScaleLabel}" TextWrapping="Wrap" />
              <TextBlock Classes="MutedMeta" Text="{Binding Loc.UiScaleHint}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Slider Width="140"
                      Minimum="100"
                      Maximum="300"
                      TickFrequency="25"
                      IsSnapToTickEnabled="True"
                      Value="{Binding UiScalePercent}" />
              <TextBlock Width="44"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Text="{Binding UiScaleDisplay}" />
              <Button Classes="SecondaryAction"
                      Padding="8,4"
                      FontSize="11.5"
                      Content="100%"
                      Command="{Binding ResetUiScaleCommand}" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="4">
            <CheckBox IsChecked="{Binding StartOnBoot}"
                      IsEnabled="{Binding IsAutostartSupported}"
                      Content="{Binding Loc.StartOnBootCheckbox}" />
            <TextBlock Classes="MutedMeta" Margin="28,0,0,0" Text="{Binding Loc.StartOnBootHint}" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <CheckBox Grid.Column="0"
                      IsChecked="{Binding NotificationsEnabled}"
                      Content="{Binding Loc.NotificationsEnabledCheckbox}" />
            <Button Grid.Column="1"
                    Classes="SecondaryAction"
                    Content="{Binding Loc.TestNotificationButton}"
                    Command="{Binding TestNotificationCommand}" />
          </Grid>

          <StackPanel Spacing="8" Margin="28,0,0,0" IsEnabled="{Binding NotificationsEnabled}">
            <CheckBox IsChecked="{Binding NotificationSoundEnabled}"
                      Content="{Binding Loc.NotificationSoundCheckbox}" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="28,0,0,0" IsEnabled="{Binding NotificationSoundEnabled}">
              <TextBlock Grid.Column="0" FontSize="12.5" VerticalAlignment="Center" Classes="MutedMeta" Text="{Binding Loc.NotificationSoundToneLabel}" />
              <ComboBox Grid.Column="1"
                        Width="210"
                        ItemsSource="{Binding NotificationSoundOptions}"
                        SelectedIndex="{Binding SelectedNotificationSoundIndex}" />
              <Button Grid.Column="2"
                      Classes="SecondaryAction"
                      Padding="10,5"
                      Content="{Binding Loc.PreviewSoundButton}"
                      Command="{Binding PreviewNotificationSoundCommand}" />
            </Grid>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4">
              <CheckBox IsChecked="{Binding GmailAccountAlertsEnabled}"
                        Content="{Binding Loc.GmailAccountAlertsCheckbox}" />
              <TextBlock Classes="MutedMeta" Margin="28,0,0,0" Text="{Binding Loc.GmailAccountAlertsHint}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="SecondaryAction"
                    VerticalAlignment="Center"
                    Content="{Binding Loc.OpenEnableGmailApiButton}"
                    Command="{Binding OpenEnableGmailApiCommand}" />
          </Grid>

          <CheckBox IsChecked="{Binding MinimizeToTrayOnClose}"
                    Content="{Binding Loc.MinimizeToTrayCheckbox}" />

          <StackPanel Spacing="8">
            <CheckBox IsChecked="{Binding AutoCheckUpdates}"
                      Content="{Binding Loc.AutoCheckUpdatesCheckbox}" />
            <TextBlock Classes="MutedMeta" Margin="28,0,0,0" Text="{Binding Loc.AutoCheckUpdatesHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="28,2,0,0" IsEnabled="{Binding AutoCheckUpdates}">
              <TextBlock Grid.Column="0" FontSize="12.5" VerticalAlignment="Center" Classes="MutedMeta" Text="{Binding Loc.UpdateFrequencyLabel}" />
              <ComboBox Grid.Column="1"
                        Width="235"
                        ItemsSource="{Binding UpdateFrequencies}"
                        SelectedIndex="{Binding SelectedUpdateFrequencyIndex}" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock FontSize="13" Text="{Binding Loc.DownloadDirectoryLabel}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       FontFamily="monospace"
                       FontSize="12"
                       Text="{Binding DownloadDirectory}" />
              <Button Grid.Column="1"
                      Classes="SecondaryAction"
                      Content="{Binding Loc.BrowseFolderButton}"
                      Command="{Binding BrowseDownloadDirectoryCommand}" />
            </Grid>
            <TextBlock Classes="MutedMeta" Text="{Binding Loc.DownloadDirectoryHint}" TextWrapping="Wrap" />
          </StackPanel>

          <Border Classes="FlatRow" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding AutoMemoryCleanupEnabled}"
                          Content="{Binding Loc.AutoMemoryCleanupLabel}" />
                <TextBlock Classes="MutedMeta" Margin="28,0,0,0" Text="{Binding Loc.AutoMemoryCleanupHint}" TextWrapping="Wrap" />
                <TextBlock Classes="MutedMeta" Margin="28,2,0,0" FontSize="11.5" Foreground="#93C5FD" Text="{Binding MemoryCleanerStatusText}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsEnabled="{Binding AutoMemoryCleanupEnabled}">
                  <TextBlock Classes="MutedMeta" VerticalAlignment="Center" Text="{Binding Loc.MemoryCleanupIntervalLabel}" />
                  <NumericUpDown Width="105"
                                 Minimum="1"
                                 Maximum="60"
                                 Increment="1"
                                 Value="{Binding MemoryCleanupIntervalMinutes}" />
                </StackPanel>
                <Button Classes="SecondaryAction"
                        Padding="11,5"
                        FontSize="12"
                        IsEnabled="{Binding !IsCleaningMemory}"
                        Content="{Binding Loc.CleanMemoryNowButton}"
                        Command="{Binding CleanMemoryNowCommand}" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Credenciais JSON e Contas Conectadas -->
      <Border Classes="SurfaceCard" DragDrop.AllowDrop="True">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="SectionTitle" Text="{Binding Loc.CredentialsAccountsSectionTitle}" />
              <TextBlock Classes="MutedMeta" FontSize="12" Text="{Binding Loc.CredentialsAccountsSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="SecondaryAction"
                      Padding="10,6"
                      FontSize="12"
                      Content="{Binding Loc.OpenAccountsFolderButton}"
                      Command="{Binding OpenAccountsRootFolderCommand}" />
              <Button Classes="PrimaryAction"
                      Padding="11,6"
                      FontSize="12.5"
                      Content="{Binding Loc.AddAccountShortButton}"
                      IsEnabled="{Binding !IsCredentialsBusy}"
                      Command="{Binding AddAccountFromSettingsCommand}" />
            </StackPanel>
          </Grid>

          <!-- Feedback claro de importação / manipulação de conta -->
          <Border Background="{Binding CredentialsFeedbackBgBrush}"
                  BorderBrush="{Binding CredentialsFeedbackBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,9"
                  IsVisible="{Binding HasCredentialsFeedback}">
            <TextBlock FontSize="12.5"
                       FontWeight="Medium"
                       Foreground="{Binding CredentialsFeedbackTextBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding CredentialsFeedbackMessage}" />
          </Border>

          <!-- Detecção automática de client_secret_*.json em Downloads -->
          <Border Background="#112238"
                  BorderBrush="#2563EB"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,10"
                  IsVisible="{Binding HasDetectedDownloadsJson}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#93C5FD" Text="{Binding Loc.DetectedDownloadsTitle}" />
                <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="{Binding DetectedDownloadsSummary}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="PrimaryAction"
                      Padding="11,5"
                      FontSize="12"
                      VerticalAlignment="Center"
                      IsEnabled="{Binding !IsCredentialsBusy}"
                      Content="{Binding Loc.UseDetectedJsonButton}"
                      Command="{Binding ImportDetectedDownloadsJsonCommand}" />
            </Grid>
          </Border>

          <Border Background="#13171F"
                  BorderBrush="#334155"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,10"
                  IsVisible="{Binding IsAddAccountPromptVisible}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Loc.AddAccountPromptTitle}" />
              <Button Grid.Column="1" Classes="PrimaryAction" Padding="10,5" FontSize="12" Content="{Binding Loc.AddAccountImportNewJson}" Command="{Binding ImportJsonAndAddAccountFromSettingsCommand}" />
              <Button Grid.Column="2" Classes="SecondaryAction" Padding="10,5" FontSize="12" Content="{Binding Loc.AddAccountUseCurrentJson}" Command="{Binding ContinueWithCurrentJsonFromSettingsCommand}" />
              <Button Grid.Column="3" Classes="SecondaryAction" Padding="8,5" FontSize="12" Content="✕" Command="{Binding CancelAddAccountPromptFromSettingsCommand}" />
            </Grid>
          </Border>

          <!-- Cartão do credentials.json global (arrastar e soltar + metadados) -->
          <Border Classes="FlatRow" Background="#13171F" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Grid.Column="0"
                      Width="36" Height="36"
                      CornerRadius="8"
                      Background="#1B2230"
                      BorderBrush="{StaticResource TundraBorderBrush}"
                      BorderThickness="1"
                      VerticalAlignment="Center">
                <PathIcon Width="16" Height="16"
                          Foreground="#60A5FA"
                          Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
              </Border>

              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Loc.CredentialsFileLabel}" />
                  <Border Background="#123026"
                          CornerRadius="4"
                          Padding="6,2"
                          IsVisible="{Binding HasCredentialsJson}">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" Text="{Binding CredentialsStatusBadgeText}" />
                  </Border>
                  <Border Background="#3B2512"
                          CornerRadius="4"
                          Padding="6,2"
                          IsVisible="{Binding !HasCredentialsJson}">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FCD34D" Text="{Binding CredentialsStatusBadgeText}" />
                  </Border>
                </StackPanel>

                <TextBlock Classes="MutedMeta"
                           FontSize="11.5"
                           FontFamily="monospace"
                           Foreground="#93C5FD"
                           IsVisible="{Binding HasCredentialsMetadata}"
                           Text="{Binding CredentialsMetadataText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="MutedMeta"
                           FontSize="11"
                           Text="{Binding Loc.CredentialsDragDropHint}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="SecondaryAction"
                        Margin="0,0,6,4"
                        Padding="10,5"
                        FontSize="12"
                        Content="{Binding Loc.OpenLocalFolderMenu}"
                        Command="{Binding OpenCredentialsFolderCommand}" />
                <Button Classes="SecondaryAction"
                        Margin="0,0,6,4"
                        Padding="10,5"
                        FontSize="12"
                        Content="{Binding Loc.ImportCredentialsButton}"
                        IsEnabled="{Binding !IsCredentialsBusy}"
                        Command="{Binding ImportCredentialsJsonCommand}" />
                <Button Classes="DangerAction"
                        Margin="0,0,0,4"
                        Padding="11,5"
                        FontSize="12"
                        Content="{Binding Loc.RevokeJsonOnlyButton}"
                        IsEnabled="{Binding CanRevokeCredentialsJson}"
                        Command="{Binding RevokeCredentialsJsonCommand}" />
              </WrapPanel>
            </Grid>
          </Border>

          <!-- Confirmação de remoção de conta com opção de excluir configuração de pastas -->
          <Border Background="#2A1215"
                  BorderBrush="#991B1B"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,10"
                  IsVisible="{Binding HasPendingAccountRemoval}">
            <StackPanel Spacing="8">
              <TextBlock FontSize="12.5"
                         FontWeight="SemiBold"
                         Foreground="#FECACA"
                         TextWrapping="Wrap"
                         Text="{Binding PendingRemoveAccountPromptText}" />
              <CheckBox IsChecked="{Binding PendingRemoveDeleteFolders}"
                        Content="{Binding Loc.DeleteAccountFoldersCheckbox}" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="DangerAction"
                        Margin="0,0,8,0"
                        Padding="11,5"
                        FontSize="12"
                        Content="{Binding Loc.ConfirmRemoveAccountButton}"
                        Command="{Binding ConfirmRemoveAccountCommand}" />
                <Button Classes="SecondaryAction"
                        Padding="10,5"
                        FontSize="12"
                        Content="{Binding Loc.CancelButton}"
                        Command="{Binding CancelRemoveAccountCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Lista de contas conectadas -->
          <Border Classes="FlatRow" Padding="14,12" IsVisible="{Binding !HasConnectedAccounts}">
            <TextBlock Classes="MutedMeta" Text="{Binding Loc.ConnectedAccountsEmptyHint}" />
          </Border>

          <ItemsControl ItemsSource="{Binding ConnectedAccounts}" IsVisible="{Binding HasConnectedAccounts}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsAccountItemViewModel">
                <Border Classes="FlatRow" Padding="14,12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                      <Ellipse Width="38" Height="38" Fill="#252B36" Stroke="{StaticResource TundraBorderBrush}" StrokeThickness="1" IsVisible="{Binding !HasAvatar}" />
                      <PathIcon Width="16" Height="16"
                                Foreground="{StaticResource TundraAccent}"
                                IsVisible="{Binding !HasAvatar}"
                                Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                      <Ellipse Width="38" Height="38" Stroke="{StaticResource TundraBorderBrush}" StrokeThickness="1" IsVisible="{Binding HasAvatar}">
                        <Ellipse.Fill>
                          <ImageBrush Source="{Binding AvatarBitmap}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                        </Ellipse.Fill>
                      </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <Border CornerRadius="4" Padding="6,2" Background="{Binding JsonBadgeBgBrush}">
                          <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding JsonBadgeFgBrush}" Text="{Binding JsonBadgeText}" />
                        </Border>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsActive}">
                          <PathIcon Width="12" Height="12"
                                    Foreground="#34D399"
                                    Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                          <TextBlock FontSize="11.5"
                                     FontWeight="SemiBold"
                                     Foreground="#6EE7B7"
                                     VerticalAlignment="Center"
                                     Text="{Binding ActiveBadgeText}" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Classes="MutedMeta" FontSize="12" Text="{Binding EmailAddress}" />
                      <TextBlock Classes="MutedMeta" FontSize="11.5" Text="{Binding QuotaSummary}" />
                      <TextBlock Classes="MutedMeta" FontSize="11" FontFamily="monospace" Text="{Binding JsonDetailText}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="MutedMeta" FontSize="10.5" FontFamily="monospace" Foreground="#64748B" Text="{Binding AccountFolderDisplay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <Button Classes="SecondaryAction"
                              Margin="0,0,6,4"
                              Padding="10,5"
                              FontSize="12"
                              IsVisible="{Binding CanSwitch}"
                              Content="{Binding SwitchButtonText}"
                              Command="{Binding SwitchCommand}" />
                      <Button Classes="SecondaryAction"
                              Margin="0,0,6,4"
                              Padding="10,5"
                              FontSize="12"
                              Content="{Binding ReconnectButtonText}"
                              Command="{Binding ReconnectCommand}" />
                      <Button Classes="SecondaryAction"
                              Margin="0,0,6,4"
                              Padding="10,5"
                              FontSize="12"
                              Content="{Binding ReplaceJsonButtonText}"
                              Command="{Binding ReplaceJsonCommand}" />
                      <Button Classes="SecondaryAction"
                              Margin="0,0,6,4"
                              Padding="10,5"
                              FontSize="12"
                              Content="{Binding OpenFolderButtonText}"
                              Command="{Binding OpenFolderCommand}" />
                      <Button Classes="DangerAction"
                              Margin="0,0,0,4"
                              Padding="11,5"
                              FontSize="12"
                              Content="{Binding RevokeButtonText}"
                              Command="{Binding RevokeCommand}" />
                    </WrapPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Motor de sincronização -->
      <Border Classes="SurfaceCard">
        <StackPanel Spacing="12">
          <TextBlock Classes="SectionTitle" Text="{Binding Loc.SyncEngineSectionTitle}" />

          <Border Classes="FlatRow" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Loc.SyncIntervalLabel}" TextWrapping="Wrap" />
                <TextBlock Classes="MutedMeta" Text="{Binding Loc.SyncIntervalHint}" TextWrapping="Wrap" />
              </StackPanel>
              <NumericUpDown Grid.Column="1"
                             Width="150"
                             Minimum="30"
                             Maximum="86400"
                             Increment="30"
                             Value="{Binding SyncIntervalSeconds}" />
            </Grid>
          </Border>

          <Border Classes="FlatRow" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Loc.ConflictPolicyLabel}" TextWrapping="Wrap" />
                <TextBlock Classes="MutedMeta" Text="{Binding Loc.ConflictPolicyHint}" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        Width="260"
                        ItemsSource="{Binding ConflictPolicies}"
                        SelectedIndex="{Binding SelectedConflictPolicyIndex}" />
            </Grid>
          </Border>

          <Border Classes="FlatRow" Padding="14,10">
            <CheckBox IsChecked="{Binding WatchLocalChanges}"
                      Content="{Binding Loc.WatchLocalChangesCheckbox}" />
          </Border>

          <Border Classes="FlatRow" Padding="14,12">
            <StackPanel Spacing="8">
              <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Loc.IgnorePatternsLabel}" />
              <TextBox AcceptsReturn="True"
                       Height="120"
                       FontFamily="monospace"
                       FontSize="12"
                       Padding="12,10"
                       Text="{Binding IgnorePatternsText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- API REST local -->
      <Border Classes="SurfaceCard">
        <StackPanel Spacing="12">
          <TextBlock Classes="SectionTitle" Text="{Binding Loc.LocalApiSectionTitle}" />

          <Border Classes="FlatRow" Padding="14,10">
            <CheckBox IsChecked="{Binding EmbeddedApiEnabled}"
                      Content="{Binding Loc.EnableLocalApiCheckbox}" />
          </Border>

          <Border Classes="FlatRow" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Loc.LocalApiPortLabel}" TextWrapping="Wrap" />
                <TextBlock Classes="MutedMeta" Text="{Binding Loc.LocalApiPortHint}" TextWrapping="Wrap" />
              </StackPanel>
              <NumericUpDown Grid.Column="1"
                             Width="150"
                             Minimum="1024"
                             Maximum="65535"
                             Value="{Binding EmbeddedApiPort}" />
            </Grid>
          </Border>

          <Border Classes="FlatRow" Padding="14,12">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Loc.CurrentApiStatusLabel}" />
                  <TextBlock Classes="Subtitle" FontSize="12.5" Text="{Binding ApiEndpointStatus}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="SecondaryAction"
                          Padding="10,5"
                          FontSize="12"
                          Content="{Binding Loc.OpenApiDocsButton}"
                          Command="{Binding OpenApiDocsCommand}" />
                  <Button Classes="SecondaryAction"
                          Padding="10,5"
                          FontSize="12"
                          Content="{Binding Loc.OpenApiSpecButton}"
                          Command="{Binding OpenApiSpecCommand}" />
                </StackPanel>
              </Grid>

              <WrapPanel Orientation="Horizontal">
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/status" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/openapi.json" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/sync/trigger" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/files/search" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/files/list" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/files/trash" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/folders" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/upload" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/download" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/{id}/move" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/{id}/trash" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="POST /api/v1/files/{id}/restore" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="DELETE /api/v1/files/{id}" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/transfers" />
                </Border>
                <Border Background="#13171F" BorderBrush="{StaticResource TundraBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                  <TextBlock Classes="MutedMeta" FontFamily="monospace" FontSize="11.5" Text="GET /api/v1/logs" />
                </Border>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Repositório GitHub -->
      <Border Classes="SurfaceCard">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="SectionTitle" Text="{Binding Loc.AboutSectionTitle}" />
            <TextBlock Classes="Subtitle" FontSize="12.5" Text="{Binding Loc.AboutDescription}" TextWrapping="Wrap" />
          </StackPanel>

          <Button Grid.Column="1"
                  Classes="SecondaryAction"
                  VerticalAlignment="Center"
                  Command="{Binding OpenRepositoryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="15" Height="15"
                        Foreground="{StaticResource TundraTextPrimary}"
                        Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              <TextBlock Text="GitHub: TundraLab/Custodia" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Class="TundraDrive.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

  <!-- Accounts tab -->
  <ScrollViewer Padding="24" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20">
      <Grid MinHeight="48">
        <TextBlock Classes="m3-page-title" VerticalAlignment="Center" Text="{Binding Loc.AccountsTitle}" />
      </Grid>

      <!-- Active account and storage quota card -->
      <Border Classes="m3-card">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding Loc.RefreshQuotaButton}"
                      IsVisible="{Binding IsConnected}"
                      Command="{Binding RefreshCommand}" />
            <MenuItem Header="{Binding Loc.CopyEmailMenu}"
                      IsVisible="{Binding IsConnected}"
                      Command="{Binding CopyEmailCommand}" />
            <MenuItem Header="{Binding Loc.BuyMoreStorageButton}"
                      IsVisible="{Binding IsConnected}"
                      Command="{Binding BuyMoreStorageCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Spacing="16">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12" ColumnSpacing="12">
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12">
              <Border Width="44"
                      Height="44"
                      CornerRadius="22"
                      ClipToBounds="True"
                      Background="{DynamicResource M3SecondaryContainer}">
                <Grid>
                  <PathIcon Width="20" Height="20"
                            Foreground="{DynamicResource M3Primary}"
                            IsVisible="{Binding !HasAccountAvatar}"
                            Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 4c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm0 14c-2.03 0-4.43-.82-6.14-2.88C7.55 15.8 9.68 15 12 15s4.45.8 6.14 2.12C16.43 19.18 14.03 20 12 20z" />
                  <Image Source="{Binding AccountAvatarBitmap}"
                         Stretch="UniformToFill"
                         IsVisible="{Binding HasAccountAvatar}" />
                </Grid>
              </Border>

              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="m3-section-title" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                <TextBlock Classes="m3-subtitle" Text="{Binding EmailAddress}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
              <Button Classes="m3-tonal"
                      Margin="0,0,8,6"
                      Content="{Binding Loc.ImportCredentialsButton}"
                      Command="{Binding ImportCredentialsCommand}"
                      IsVisible="{Binding !IsConnected}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Classes="m3-filled"
                      Margin="0,0,8,6"
                      Content="{Binding Loc.ConnectGoogleButton}"
                      Command="{Binding ConnectCommand}"
                      IsVisible="{Binding !IsConnected}" />
              <Button Classes="m3-danger-outlined"
                      Margin="0,0,8,6"
                      Content="{Binding Loc.CancelAuthButton}"
                      Command="{Binding CancelConnectCommand}"
                      IsVisible="{Binding IsConnecting}" />
              <Button Classes="m3-tonal"
                      Margin="0,0,8,6"
                      Command="{Binding RefreshCommand}"
                      IsVisible="{Binding IsConnected}"
                      IsEnabled="{Binding !IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="13" Height="13"
                            IsVisible="{Binding ShowDefaultRefreshIcon}"
                            Foreground="{DynamicResource M3OnSecondaryContainer}"
                            Data="{StaticResource TundraRefreshGeometry}" />
                  <PathIcon Width="13" Height="13"
                            Classes="m3-spinning"
                            RenderTransformOrigin="50%,50%"
                            IsVisible="{Binding IsRefreshingQuota}"
                            Foreground="{DynamicResource M3Primary}"
                            Data="{StaticResource TundraRefreshGeometry}">
                    <PathIcon.RenderTransform>
                      <RotateTransform />
                    </PathIcon.RenderTransform>
                  </PathIcon>
                  <PathIcon Width="13" Height="13"
                            IsVisible="{Binding IsQuotaRefreshed}"
                            Foreground="{DynamicResource M3Success}"
                            Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                  <TextBlock Text="{Binding Loc.RefreshQuotaButton}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="m3-danger-outlined"
                      Margin="0,0,8,6"
                      Content="{Binding Loc.DisconnectButton}"
                      Command="{Binding DisconnectCommand}"
                      IsVisible="{Binding IsConnected}"
                      IsEnabled="{Binding !IsBusy}" />
            </WrapPanel>
          </Grid>

          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Grid.Column="0" Classes="m3-meta" FontSize="12.5" Text="{Binding Loc.StorageLabel}" />
              <TextBlock Grid.Column="1" Classes="m3-meta" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding QuotaUsageText}" />
            </Grid>

            <Border Height="8"
                    CornerRadius="4"
                    Background="{DynamicResource M3SurfaceContainerHighest}"
                    ClipToBounds="True"
                    HorizontalAlignment="Stretch"
                    SizeChanged="OnStorageBarSizeChanged">
              <StackPanel Orientation="Horizontal" Spacing="1">
                <Border Background="{DynamicResource M3Primary}" Width="{Binding DriveBarWidth}" Height="8" />
                <Border Background="{DynamicResource M3Tertiary}" Width="{Binding OtherBarWidth}" Height="8" />
                <Border Background="{DynamicResource M3StorageTrash}" Width="{Binding TrashBarWidth}" Height="8" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,2">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource M3Primary}" VerticalAlignment="Center" />
                    <TextBlock Classes="m3-meta" FontSize="11.5" Text="{Binding Loc.StorageDriveLegend}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,2">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource M3Tertiary}" VerticalAlignment="Center" />
                    <TextBlock Classes="m3-meta" FontSize="11.5" Text="{Binding Loc.StorageOtherLegend}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,2">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource M3StorageTrash}" VerticalAlignment="Center" />
                    <TextBlock Classes="m3-meta" FontSize="11.5" Text="{Binding Loc.StorageTrashLegend}" />
                  </StackPanel>
                </WrapPanel>
                <TextBlock Classes="m3-meta" FontSize="11.5" Text="{Binding QuotaBreakdownText}" TextWrapping="Wrap" />
              </StackPanel>

              <Button Grid.Column="1"
                      Classes="m3-outlined m3-compact"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsConnected}"
                      Content="{Binding Loc.BuyMoreStorageButton}"
                      Command="{Binding BuyMoreStorageCommand}" />
            </Grid>

            <Border IsVisible="{Binding HasStorageAlert}"
                    Background="{DynamicResource M3WarningContainer}"
                    BorderBrush="{Binding StorageProgressBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10"
                    Margin="0,4,0,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{Binding StorageAlertTextBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding StorageAlertMessage}" />
                <Button Grid.Column="1"
                        Classes="m3-filled m3-compact"
                        Content="{Binding Loc.BuyMoreStorageButton}"
                        Command="{Binding BuyMoreStorageCommand}" />
              </Grid>
            </Border>
          </StackPanel>

          <TextBlock Classes="m3-meta"
                     TextWrapping="Wrap"
                     Text="{Binding StatusMessage}"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- Guided OAuth onboarding steps (Inset Grouped List) -->
      <StackPanel Spacing="8" IsVisible="{Binding !IsConnected}">
        <TextBlock Classes="m3-group-label" Margin="4,0,0,0" Text="{Binding Loc.OnboardingTitle}" />

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.OnboardingStep1Title}" TextWrapping="Wrap" />
                <TextBlock Classes="m3-subtitle" FontSize="12" Text="{Binding Loc.OnboardingStep1Desc}" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button Classes="m3-tonal m3-compact"
                          Margin="0,0,8,4"
                          Content="{Binding Loc.OpenEnableDriveApiButton}"
                          Command="{Binding OpenEnableDriveApiCommand}" />
                  <Button Classes="m3-outlined m3-compact"
                          Margin="0,0,8,4"
                          Content="{Binding Loc.OpenCloudConsoleButton}"
                          Command="{Binding OpenCloudConsoleCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.OnboardingStep2Title}" TextWrapping="Wrap" />
                <TextBlock Classes="m3-subtitle" FontSize="12" Text="{Binding Loc.OnboardingStep2Desc}" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button Classes="m3-tonal m3-compact"
                          Content="{Binding Loc.ImportCredentialsButton}"
                          Command="{Binding ImportCredentialsCommand}"
                          IsEnabled="{Binding !IsBusy}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.OnboardingStep3Title}" TextWrapping="Wrap" />
                <TextBlock Classes="m3-subtitle" FontSize="12" Text="{Binding Loc.OnboardingStep3Desc}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Credentials and token storage security (Inset Grouped List) -->
      <StackPanel Spacing="8">
        <TextBlock Classes="m3-group-label" Margin="4,0,0,0" Text="{Binding Loc.SecuritySectionTitle}" />

        <Border Classes="m3-grouped-list">
          <StackPanel>
            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="4">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.CredentialsFileLabel}" TextWrapping="Wrap" />
                <TextBlock Classes="m3-meta" FontFamily="monospace" Text="{Binding CredentialsPath}" TextWrapping="Wrap" />
                <TextBlock Classes="m3-subtitle" FontSize="12" Text="{Binding CredentialsStatusText}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <StackPanel Spacing="4">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.TokensDirLabel}" TextWrapping="Wrap" />
                <TextBlock Classes="m3-meta" FontFamily="monospace" Text="{Binding TokensDirectoryPath}" TextWrapping="Wrap" />
                <TextBlock Classes="m3-subtitle" FontSize="12" Text="{Binding TokenSecurityText}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="m3-divider" />

            <Border Classes="m3-grouped-row">
              <TextBlock Classes="m3-meta" TextWrapping="Wrap" Text="{Binding Loc.SafeDeletionNotice}" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

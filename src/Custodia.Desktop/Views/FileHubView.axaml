<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Class="TundraDrive.Desktop.Views.FileHubView"
             x:DataType="vm:FileHubViewModel"
             DragDrop.AllowDrop="True">

  <!-- Aba meus arquivos -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24" RowSpacing="12">
    <!-- Cabeçalho + Barra de armazenamento segmentada -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <TextBlock Grid.Column="0" Classes="PageTitle" VerticalAlignment="Center" Text="{Binding Loc.FileHubTitle}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsAccountConnected}">
        <StackPanel Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding QuotaBreakdownTooltip}">
          <TextBlock Classes="MutedMeta" FontSize="11.5" HorizontalAlignment="Right" Text="{Binding QuotaShortText}" />
          <Border Height="6" Width="170" CornerRadius="3" Background="#252B36" ClipToBounds="True">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <Border Background="#3B82F6" Width="{Binding DriveBarWidth}" Height="6" />
              <Border Background="#22D3EE" Width="{Binding OtherBarWidth}" Height="6" />
              <Border Background="#64748B" Width="{Binding TrashBarWidth}" Height="6" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Button Classes="SecondaryAction"
                Padding="10,5"
                Content="{Binding Loc.BuyMoreShortButton}"
                Command="{Binding BuyMoreStorageCommand}" />
      </StackPanel>
    </Grid>

    <!-- Barra de navegação e alternância de visão -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Border Grid.Column="0" Classes="FlatRow" Padding="8,5" MinWidth="200">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
          <Button Grid.Column="0"
                  Classes="SecondaryAction"
                  Padding="8,4"
                  IsEnabled="{Binding CanNavigateBack}"
                  ToolTip.Tip="{Binding Loc.BackButton}"
                  Command="{Binding NavigateBackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Width="12" Height="12" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
              <TextBlock FontSize="12" Text="{Binding Loc.BackButton}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Classes="SecondaryAction"
                  Padding="8,4"
                  FontSize="12"
                  Content="{Binding RootBreadcrumbLabel}"
                  Command="{Binding NavigateToRootCommand}" />
          <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FileHubBreadcrumbItem">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Content="{Binding Name}"
                            Command="{Binding SelectCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,2"
                            FontSize="12.5"
                            Foreground="{StaticResource TundraTextPrimary}" />
                    <TextBlock Text="/" VerticalAlignment="Center" Classes="MutedMeta" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="SecondaryAction"
                Classes.ActiveTab="{Binding IsDriveFilter}"
                Padding="10,5"
                FontSize="12"
                Command="{Binding SelectDriveFilterCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="13" Height="13" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z" />
            <TextBlock FontSize="12" Text="{Binding Loc.FileHubFilterDrive}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="SecondaryAction"
                Classes.ActiveTab="{Binding IsLocalFilter}"
                Padding="10,5"
                FontSize="12"
                Command="{Binding SelectLocalFilterCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="13" Height="13" Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
            <TextBlock FontSize="12" Text="{Binding Loc.FileHubFilterLocal}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="SecondaryAction"
                Classes.ActiveTrashTab="{Binding IsTrashView}"
                BorderBrush="#7F1D1D"
                Padding="11,5"
                ToolTip.Tip="{Binding Loc.OpenTrashTooltip}"
                Command="{Binding SelectTrashFilterCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="13" Height="13" Foreground="#FCA5A5" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FCA5A5" Text="{Binding TrashTabDisplay}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="SecondaryAction"
                Padding="8,5"
                ToolTip.Tip="{Binding Loc.LayoutListButton}"
                Command="{Binding SetListLayoutCommand}">
          <PathIcon Width="14" Height="14" Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" />
        </Button>
        <Button Classes="SecondaryAction"
                Padding="8,5"
                ToolTip.Tip="{Binding Loc.LayoutGridButton}"
                Command="{Binding SetGridLayoutCommand}">
          <PathIcon Width="14" Height="14" Data="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Busca + Ações contextuais + Lixeira -->
    <StackPanel Grid.Row="2" Spacing="8">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Watermark="{Binding Loc.SearchFilesWatermark}"
                 Text="{Binding SearchText}"
                 KeyDown="OnSearchBoxKeyDown" />

        <Button Grid.Column="1"
                Classes="SecondaryAction"
                Content="{Binding Loc.SearchButton}"
                Command="{Binding RefreshCommand}" />

        <Button Grid.Column="2"
                Classes="SecondaryAction"
                Content="{Binding Loc.RefreshButton}"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsLoading}" />

        <Button Grid.Column="3"
                Classes="SecondaryAction"
                IsVisible="{Binding !IsTrashView}"
                Content="{Binding Loc.NewFolderButton}"
                Command="{Binding ToggleCreateFolderCommand}"
                IsEnabled="{Binding !IsLoading}" />

        <Button Grid.Column="4"
                Classes="PrimaryAction"
                IsVisible="{Binding !IsTrashView}"
                Content="{Binding Loc.UploadFileButton}"
                Command="{Binding UploadFileCommand}"
                IsEnabled="{Binding !IsLoading}" />
      </Grid>

      <!-- Barra inline de criação de pasta -->
      <Border Classes="SurfaceCard"
              Padding="10,8"
              IsVisible="{Binding IsCreateFolderOpen}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Watermark="{Binding Loc.NewFolderPlaceholder}"
                   Text="{Binding NewFolderName}" />
          <Button Grid.Column="1"
                  Classes="PrimaryAction"
                  Padding="12,5"
                  Content="{Binding Loc.CreateFolderConfirmButton}"
                  Command="{Binding CreateFolderCommand}" />
          <Button Grid.Column="2"
                  Classes="SecondaryAction"
                  Padding="10,5"
                  Content="{Binding Loc.CancelButton}"
                  Command="{Binding ToggleCreateFolderCommand}" />
        </Grid>
      </Border>

      <!-- Banner animado de erro de upload/download -->
      <Border Classes="ErrorPulseBanner"
              Padding="12,9"
              CornerRadius="8"
              Background="#2A1215"
              BorderBrush="#B91C1C"
              BorderThickness="1"
              IsVisible="{Binding HasTransferErrorBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <PathIcon Grid.Column="0"
                    Classes="ErrorPulse"
                    Width="15" Height="15"
                    Foreground="#EF4444"
                    VerticalAlignment="Center"
                    Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z">
            <PathIcon.RenderTransform>
              <TranslateTransform />
            </PathIcon.RenderTransform>
          </PathIcon>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="#FECACA"
                     TextWrapping="Wrap"
                     Text="{Binding TransferErrorBannerText}" />
          <Button Grid.Column="2"
                  Classes="SecondaryAction"
                  Padding="8,4"
                  FontSize="12"
                  Content="✕"
                  Command="{Binding DismissTransferErrorBannerCommand}" />
        </Grid>
      </Border>

      <!-- Barra de ações contextuais para arquivos normais -->
      <Border Classes="FlatRow"
              Padding="10,6"
              IsVisible="{Binding !IsTrashView}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <WrapPanel Grid.Column="0" Orientation="Horizontal">
            <Button Classes="SecondaryAction"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.PreviewButton}"
                    IsEnabled="{Binding CanPreviewSelected}"
                    Command="{Binding PreviewSelectedCommand}" />
            <Button Classes="SecondaryAction"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.DownloadButton}"
                    IsEnabled="{Binding CanDownloadSelected}"
                    Command="{Binding DownloadSelectedCommand}" />
            <Button Classes="SecondaryAction"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.OpenInDriveButton}"
                    IsEnabled="{Binding CanOpenSelectedInDrive}"
                    Command="{Binding OpenSelectedInDriveCommand}" />
            <Button Classes="DangerAction"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.MoveToTrashButton}"
                    IsEnabled="{Binding CanTrashSelected}"
                    Command="{Binding TrashSelectedCommand}" />
            <Button Classes="SecondaryAction"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.SelectAllButton}"
                    IsEnabled="{Binding !IsFolderEmpty}"
                    Click="OnSelectAllClick" />
            <Button Classes="SecondaryAction"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.ClearSelectionButton}"
                    IsVisible="{Binding HasSelectedItem}"
                    Click="OnClearSelectionClick" />
          </WrapPanel>

          <Border Grid.Column="1"
                  Background="#1E293B"
                  CornerRadius="10"
                  Padding="8,2"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasMultipleSelected}">
            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#93C5FD" Text="{Binding SelectionCountDisplay}" />
          </Border>
        </Grid>
      </Border>

      <!-- Barra dedicada da Lixeira (sem botões duplicados) -->
      <Border Background="#20161B"
              BorderBrush="#7F1D1D"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12,8"
              IsVisible="{Binding IsTrashView}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <PathIcon Grid.Column="0" Width="15" Height="15" Foreground="#F87171" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock FontSize="12.5"
                       Foreground="#FECACA"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding Loc.TrashBannerTitle}" />
            <Border Background="#7F1D1D"
                    CornerRadius="10"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasMultipleSelected}">
              <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#FEE2E2" Text="{Binding SelectionCountDisplay}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="SecondaryAction"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.SelectAllButton}"
                    IsEnabled="{Binding !IsFolderEmpty}"
                    Click="OnSelectAllClick" />
            <Button Classes="SecondaryAction"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.PreviewButton}"
                    IsEnabled="{Binding CanPreviewSelected}"
                    Command="{Binding PreviewSelectedCommand}" />
            <Button Classes="SecondaryAction"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.RestoreFromTrashButton}"
                    IsEnabled="{Binding CanRestoreSelected}"
                    Command="{Binding RestoreSelectedCommand}" />
            <Button Classes="DangerAction"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.DeletePermanentlyButton}"
                    IsEnabled="{Binding CanDeleteSelectedPermanently}"
                    Command="{Binding DeleteSelectedPermanentlyCommand}" />
            <Button Classes="DangerAction"
                    Padding="10,4"
                    FontSize="12"
                    Content="{Binding Loc.EmptyTrashButton}"
                    IsEnabled="{Binding CanEmptyTrash}"
                    Command="{Binding RequestEmptyTrashCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Background="#2A1619"
              BorderBrush="#991B1B"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12,8"
              IsVisible="{Binding IsEmptyTrashConfirmVisible}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     FontSize="12.5"
                     FontWeight="Medium"
                     Foreground="#FCA5A5"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{Binding Loc.EmptyTrashConfirmTitle}" />
          <Button Grid.Column="1"
                  Classes="SecondaryAction"
                  Padding="10,4"
                  Content="{Binding Loc.CancelButton}"
                  Command="{Binding CancelEmptyTrashCommand}" />
          <Button Grid.Column="2"
                  Classes="DangerAction"
                  Padding="10,4"
                  Content="{Binding Loc.ConfirmButton}"
                  Command="{Binding ConfirmEmptyTrashCommand}" />
        </Grid>
      </Border>
    </StackPanel>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Border Grid.Column="0" Classes="SurfaceCard" Padding="0" ClipToBounds="True">
        <Grid>
          <!-- Layout em lista -->
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsGridLayout}">
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource TundraBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
              <Grid ColumnDefinitions="28,*,110,90,135" ColumnSpacing="8">
                <TextBlock Grid.Column="1" Classes="MutedMeta" Text="{Binding Loc.ColName}" />
                <TextBlock Grid.Column="2" Classes="MutedMeta" Text="{Binding Loc.ColOrigin}" />
                <TextBlock Grid.Column="3" Classes="MutedMeta" Text="{Binding Loc.ColSize}" />
                <TextBlock Grid.Column="4" Classes="MutedMeta" Text="{Binding Loc.ColModified}" />
              </Grid>
            </Border>

            <ListBox x:Name="ListFilesListBox"
                     Grid.Row="1"
                     Classes="FlatRowList"
                     SelectionMode="Multiple"
                     ItemsSource="{Binding ActiveListFiles}"
                     SelectedItem="{Binding SelectedItem}"
                     SelectionChanged="OnFileSelectionChanged"
                     PointerPressed="OnFileListPointerPressed"
                     DoubleTapped="OnListDoubleTapped">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding SelectedItem.PreviewLabel}"
                            IsVisible="{Binding CanPreviewSelected}"
                            Command="{Binding SelectedItem.PreviewCommand}" />
                  <MenuItem Header="{Binding Loc.DownloadButton}"
                            IsVisible="{Binding CanDownloadSelected}"
                            Command="{Binding DownloadSelectedCommand}" />
                  <MenuItem Header="{Binding SelectedItem.ActionLabel}"
                            IsVisible="{Binding SelectedItem.CanOpenNormal, FallbackValue=False}"
                            Command="{Binding SelectedItem.OpenActionCommand}" />
                  <MenuItem Header="{Binding SelectedItem.OpenInDriveLabel}"
                            IsVisible="{Binding SelectedItem.CanCopyDriveLink, FallbackValue=False}"
                            Command="{Binding SelectedItem.OpenInDriveCommand}" />
                  <Separator IsVisible="{Binding SelectedItem.CanOpenNormal, FallbackValue=False}" />
                  <MenuItem Header="{Binding SelectedItem.CopyNameLabel}"
                            IsVisible="{Binding HasSelectedItem}"
                            Command="{Binding SelectedItem.CopyNameCommand}" />
                  <MenuItem Header="{Binding SelectedItem.CopyLinkLabel}"
                            IsVisible="{Binding SelectedItem.CanCopyDriveLink, FallbackValue=False}"
                            Command="{Binding SelectedItem.CopyDriveLinkCommand}" />
                  <Separator IsVisible="{Binding CanTrashSelected}" />
                  <MenuItem Header="{Binding Loc.MoveToTrashButton}"
                            IsVisible="{Binding CanTrashSelected}"
                            Command="{Binding TrashSelectedCommand}" />
                  <MenuItem Header="{Binding Loc.RestoreFromTrashButton}"
                            IsVisible="{Binding CanRestoreSelected}"
                            Command="{Binding RestoreSelectedCommand}" />
                  <MenuItem Header="{Binding Loc.DeletePermanentlyButton}"
                            IsVisible="{Binding CanDeleteSelectedPermanently}"
                            Command="{Binding DeleteSelectedPermanentlyCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileHubItemViewModel">
                  <Border Padding="8,7" Background="Transparent">
                    <Grid ColumnDefinitions="28,*,110,90,135" ColumnSpacing="8">
                      <CheckBox Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MinWidth="0" MinHeight="0" Padding="0"
                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                Click="OnItemCheckBoxClick" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Width="15" Height="15"
                                    Foreground="{Binding FileIconBrush}"
                                    Data="{Binding FileIconData}" />
                          <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Classes="MutedMeta" FontSize="11" Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <TextBlock Grid.Column="2"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding OriginBrush}"
                                 Text="{Binding OriginDisplay}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Classes="MutedMeta" VerticalAlignment="Center" Text="{Binding SizeDisplay}" />
                      <TextBlock Grid.Column="4" Classes="MutedMeta" VerticalAlignment="Center" Text="{Binding ModifiedDisplay}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <!-- Layout em grade leve (paginado com menu de contexto compartilhado) -->
          <ListBox x:Name="GridFilesListBox"
                   Classes="FileGridList"
                   SelectionMode="Multiple"
                   IsVisible="{Binding IsGridLayout}"
                   Padding="14"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ItemsSource="{Binding ActiveGridFiles}"
                   SelectedItem="{Binding SelectedItem}"
                   SelectionChanged="OnFileSelectionChanged"
                   PointerPressed="OnFileListPointerPressed"
                   DoubleTapped="OnListDoubleTapped">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding SelectedItem.PreviewLabel}"
                          IsVisible="{Binding CanPreviewSelected}"
                          Command="{Binding SelectedItem.PreviewCommand}" />
                <MenuItem Header="{Binding Loc.DownloadButton}"
                          IsVisible="{Binding CanDownloadSelected}"
                          Command="{Binding DownloadSelectedCommand}" />
                <MenuItem Header="{Binding SelectedItem.ActionLabel}"
                          IsVisible="{Binding SelectedItem.CanOpenNormal, FallbackValue=False}"
                          Command="{Binding SelectedItem.OpenActionCommand}" />
                <MenuItem Header="{Binding SelectedItem.OpenInDriveLabel}"
                          IsVisible="{Binding SelectedItem.CanCopyDriveLink, FallbackValue=False}"
                          Command="{Binding SelectedItem.OpenInDriveCommand}" />
                <Separator IsVisible="{Binding SelectedItem.CanOpenNormal, FallbackValue=False}" />
                <MenuItem Header="{Binding SelectedItem.CopyNameLabel}"
                          IsVisible="{Binding HasSelectedItem}"
                          Command="{Binding SelectedItem.CopyNameCommand}" />
                <MenuItem Header="{Binding SelectedItem.CopyLinkLabel}"
                          IsVisible="{Binding SelectedItem.CanCopyDriveLink, FallbackValue=False}"
                          Command="{Binding SelectedItem.CopyDriveLinkCommand}" />
                <Separator IsVisible="{Binding CanTrashSelected}" />
                <MenuItem Header="{Binding Loc.MoveToTrashButton}"
                          IsVisible="{Binding CanTrashSelected}"
                          Command="{Binding TrashSelectedCommand}" />
                <MenuItem Header="{Binding Loc.RestoreFromTrashButton}"
                          IsVisible="{Binding CanRestoreSelected}"
                          Command="{Binding RestoreSelectedCommand}" />
                <MenuItem Header="{Binding Loc.DeletePermanentlyButton}"
                          IsVisible="{Binding CanDeleteSelectedPermanently}"
                          Command="{Binding DeleteSelectedPermanentlyCommand}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileHubItemViewModel">
                <Border Width="184" Height="162" Padding="12" Background="Transparent">
                  <Grid RowDefinitions="*,Auto" RowSpacing="8">
                    <!-- Miniatura ou ícone colorido por tipo -->
                    <Border Grid.Row="0"
                            CornerRadius="6"
                            ClipToBounds="True"
                            Background="#141820">
                      <Grid>
                        <Image Source="{Binding ThumbnailBitmap}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding HasThumbnail}" />

                        <Border Width="34" Height="34"
                                CornerRadius="17"
                                Background="#99000000"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsVideoFile}">
                          <PathIcon Width="14" Height="14"
                                    Foreground="#FFFFFF"
                                    Data="M8 5v14l11-7z" />
                        </Border>

                        <PathIcon Width="44" Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{Binding FileIconBrush}"
                                  IsVisible="{Binding !HasThumbnail}"
                                  Data="{Binding FileIconData}" />

                        <CheckBox HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="6"
                                  MinWidth="0" MinHeight="0" Padding="0"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Click="OnItemCheckBoxClick" />
                      </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Spacing="2">
                      <TextBlock FontSize="12.5"
                                 FontWeight="Medium"
                                 HorizontalAlignment="Center"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="MutedMeta"
                                 FontSize="11"
                                 HorizontalAlignment="Center"
                                 Text="{Binding SizeDisplay}"
                                 IsVisible="{Binding !IsFolder}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ProgressBar VerticalAlignment="Top"
                       Height="2"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsLoading}" />

          <TextBlock VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Classes="Subtitle"
                     Text="{Binding EmptyStateText}"
                     IsVisible="{Binding IsFolderEmpty}" />
        </Grid>
      </Border>

      <!-- Painel lateral de pré-visualização -->
      <Border Grid.Column="1"
              Width="320"
              Classes="SurfaceCard"
              IsVisible="{Binding IsPreviewVisible}">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="SectionTitle" Text="{Binding Loc.PreviewTitle}" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="SecondaryAction"
                    Padding="8,4"
                    Content="✕"
                    Command="{Binding ClosePreviewCommand}" />
          </Grid>

          <Border Grid.Row="1"
                  Background="#13171F"
                  BorderBrush="{StaticResource TundraBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8">
            <Grid>
              <Image Source="{Binding PreviewBitmap}"
                     Stretch="Uniform"
                     IsVisible="{Binding HasVisualBitmap}" />

              <TextBox IsReadOnly="True"
                       AcceptsReturn="True"
                       FontFamily="monospace"
                       FontSize="11.5"
                       Background="Transparent"
                       BorderThickness="0"
                       Text="{Binding PreviewTextContent}"
                       IsVisible="{Binding IsTextPreview}" />

              <TextBlock VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Classes="MutedMeta"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Text="{Binding PreviewMessage}"
                         IsVisible="{Binding PreviewMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Spacing="3">
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding PreviewFileName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="MutedMeta" FontSize="11.5" Text="{Binding PreviewMetaText}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="3" Spacing="8">
            <Button Classes="SecondaryAction"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{Binding AudioToggleLabel}"
                    IsVisible="{Binding IsAudioPreview}"
                    Command="{Binding ToggleAudioPlaybackCommand}" />

            <Button Classes="SecondaryAction"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{Binding Loc.PreviewPlayVideo}"
                    IsVisible="{Binding IsVideoPreview}"
                    Command="{Binding PlayVideoCommand}" />

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding IsPdfPreview}">
              <Button Grid.Column="0"
                      Classes="SecondaryAction"
                      IsEnabled="{Binding CanPreviousPdfPage}"
                      Content="{Binding Loc.PreviewPrevPage}"
                      Command="{Binding PreviousPdfPageCommand}" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Classes="MutedMeta"
                         Text="{Binding PdfPageDisplay}" />
              <Button Grid.Column="2"
                      Classes="SecondaryAction"
                      IsEnabled="{Binding CanNextPdfPage}"
                      Content="{Binding Loc.PreviewNextPage}"
                      Command="{Binding NextPdfPageCommand}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0"
                      Classes="SecondaryAction"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Content="{Binding Loc.DownloadButton}"
                      Command="{Binding DownloadPreviewedItemCommand}" />
              <Button Grid.Column="1"
                      Classes="PrimaryAction"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Content="{Binding Loc.FileHubOpenLocal}"
                      Command="{Binding OpenPreviewedItemCommand}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Grid.Column="0" Classes="MutedMeta" VerticalAlignment="Center" Text="{Binding StatusSummary}" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasMultiplePages}">
        <Button Classes="SecondaryAction"
                Padding="8,3"
                FontSize="11.5"
                Content="◀"
                IsEnabled="{Binding CanPreviousPage}"
                Command="{Binding PreviousPageCommand}" />
        <TextBlock Classes="MutedMeta"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Text="{Binding PageDisplay}" />
        <Button Classes="SecondaryAction"
                Padding="8,3"
                FontSize="11.5"
                Content="▶"
                IsEnabled="{Binding CanNextPage}"
                Command="{Binding NextPageCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Name="FileHubRoot"
             x:Class="TundraDrive.Desktop.Views.FileHubView"
             x:DataType="vm:FileHubViewModel"
             DragDrop.AllowDrop="True">

  <!-- File hub workspace -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24" RowSpacing="12">
    <!-- Compact header and inline quota summary -->
    <Grid Grid.Row="0" MinHeight="48" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <TextBlock Grid.Column="0" Classes="m3-page-title" VerticalAlignment="Center" Text="{Binding Loc.FileHubTitle}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsAccountConnected}">
        <StackPanel Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding QuotaBreakdownTooltip}">
          <TextBlock Classes="m3-meta" FontSize="11.5" HorizontalAlignment="Right" Text="{Binding QuotaShortText}" />
          <Border Height="6" Width="170" CornerRadius="4" Background="{DynamicResource M3SurfaceContainerHighest}" ClipToBounds="True">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <Border Background="{DynamicResource M3Primary}" Width="{Binding DriveBarWidth}" Height="6" />
              <Border Background="{DynamicResource M3Tertiary}" Width="{Binding OtherBarWidth}" Height="6" />
              <Border Background="{DynamicResource M3StorageTrash}" Width="{Binding TrashBarWidth}" Height="6" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Button Classes="m3-text m3-compact"
                Foreground="{DynamicResource M3Primary}"
                FontWeight="SemiBold"
                Content="{Binding Loc.BuyMoreShortButton}"
                Command="{Binding BuyMoreStorageCommand}" />
      </StackPanel>
    </Grid>

    <!-- Breadcrumb bar and segmented source/view controls -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Border Grid.Column="0"
              Background="{DynamicResource M3SurfaceContainer}"
              CornerRadius="20"
              Padding="8,4"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsVisible="{Binding ShowBreadcrumbs}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
          <Button Grid.Column="0"
                  Classes="m3-text m3-icon"
                  MinHeight="28"
                  MinWidth="28"
                  Padding="5"
                  IsVisible="{Binding CanNavigateBack}"
                  ToolTip.Tip="{Binding Loc.BackButton}"
                  Command="{Binding NavigateBackCommand}">
            <PathIcon Width="13" Height="13" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
          </Button>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FileHubBreadcrumbItem">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="m3-text"
                            MinHeight="28"
                            Padding="10,4"
                            FontSize="12.5"
                            FontWeight="Medium"
                            Foreground="{DynamicResource M3OnSurface}"
                            Content="{Binding Name}"
                            Command="{Binding SelectCommand}" />
                    <TextBlock Text="›"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0"
                               Classes="m3-meta"
                               IsVisible="{Binding ShowSeparator}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Classes="m3-segmented-track">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="m3-segmented"
                    Classes.m3-seg-active="{Binding IsDriveFilter}"
                    Command="{Binding SelectDriveFilterCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource TundraCloudSyncGeometry}" />
                <TextBlock FontSize="12" Text="{Binding Loc.FileHubFilterDrive}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="m3-segmented"
                    Classes.m3-seg-active="{Binding IsLocalFilter}"
                    Command="{Binding SelectLocalFilterCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource TundraFolderGeometry}" />
                <TextBlock FontSize="12" Text="{Binding Loc.FileHubFilterLocal}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="m3-segmented"
                    Classes.m3-seg-active="{Binding IsFavoritesView}"
                    ToolTip.Tip="{Binding Loc.OpenFavoritesTooltip}"
                    Command="{Binding SelectFavoritesFilterCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Foreground="{DynamicResource M3Warning}" Data="{StaticResource TundraStarGeometry}" />
                <TextBlock FontSize="12" Text="{Binding Loc.FileHubFilterFavorites}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="m3-segmented"
                    Classes.m3-seg-trash-active="{Binding IsTrashView}"
                    ToolTip.Tip="{Binding Loc.OpenTrashTooltip}"
                    Command="{Binding SelectTrashFilterCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Foreground="{DynamicResource M3Error}" Data="{StaticResource TundraTrashGeometry}" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3Error}" Text="{Binding TrashTabDisplay}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="m3-segmented-track">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="m3-segmented"
                    Classes.m3-seg-active="{Binding !IsGridLayout}"
                    Padding="10,5"
                    ToolTip.Tip="{Binding Loc.LayoutListButton}"
                    Command="{Binding SetListLayoutCommand}">
              <PathIcon Width="14" Height="14" Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" />
            </Button>
            <Button Classes="m3-segmented"
                    Classes.m3-seg-active="{Binding IsGridLayout}"
                    Padding="10,5"
                    ToolTip.Tip="{Binding Loc.LayoutGridButton}"
                    Command="{Binding SetGridLayoutCommand}">
              <PathIcon Width="14" Height="14" Data="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z" />
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Search bar, contextual actions, and inline panels -->
    <StackPanel Grid.Row="2" Spacing="10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Watermark="{Binding Loc.SearchFilesWatermark}"
                 Text="{Binding SearchText}"
                 KeyDown="OnSearchBoxKeyDown">
          <TextBox.InnerLeftContent>
            <PathIcon Width="14" Height="14"
                      Margin="10,0,0,0"
                      Foreground="{DynamicResource M3OnSurfaceMuted}"
                      Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="m3-text m3-icon"
                    MinWidth="26"
                    MinHeight="26"
                    Padding="4"
                    Margin="0,0,4,0"
                    FontSize="11.5"
                    Content="✕"
                    IsVisible="{Binding HasSearchText}"
                    ToolTip.Tip="{Binding Loc.ClearSearchTooltip}"
                    Command="{Binding ClearSearchCommand}" />
          </TextBox.InnerRightContent>
        </TextBox>

        <Button Grid.Column="1"
                Classes="m3-tonal"
                Width="36"
                Height="36"
                Padding="0"
                ToolTip.Tip="{Binding Loc.RefreshButton}"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsLoading}">
          <PathIcon Width="15" Height="15"
                    Classes.m3-spinning="{Binding IsLoading}"
                    Data="{StaticResource TundraRefreshGeometry}">
            <PathIcon.RenderTransform>
              <RotateTransform />
            </PathIcon.RenderTransform>
          </PathIcon>
        </Button>

        <Button Grid.Column="2"
                Classes="m3-tonal"
                IsVisible="{Binding !IsTrashView}"
                Command="{Binding ToggleCreateFolderCommand}"
                IsEnabled="{Binding !IsLoading}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="14" Height="14" Data="{StaticResource TundraFolderGeometry}" />
            <TextBlock Text="{Binding Loc.NewFolderButton}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3"
                Classes="m3-filled"
                IsVisible="{Binding !IsTrashView}"
                Command="{Binding UploadFileCommand}"
                IsEnabled="{Binding !IsLoading}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="14" Height="14" Data="{StaticResource TundraUploadGeometry}" />
            <TextBlock Text="{Binding Loc.UploadFileButton}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Inline folder creation bar -->
      <Border Classes="m3-card"
              Padding="12,10"
              IsVisible="{Binding IsCreateFolderOpen}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox x:Name="NewFolderTextBox"
                   Grid.Column="0"
                   Watermark="{Binding Loc.NewFolderPlaceholder}"
                   Text="{Binding NewFolderName}"
                   KeyDown="OnNewFolderKeyDown" />
          <Button Grid.Column="1"
                  Classes="m3-filled m3-compact"
                  Content="{Binding Loc.CreateFolderConfirmButton}"
                  Command="{Binding CreateFolderCommand}" />
          <Button Grid.Column="2"
                  Classes="m3-outlined m3-compact"
                  Content="{Binding Loc.CancelButton}"
                  Command="{Binding ToggleCreateFolderCommand}" />
        </Grid>
      </Border>

      <!-- Inline rename bar -->
      <Border Classes="m3-card"
              Padding="12,10"
              IsVisible="{Binding IsRenameOpen}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource M3OnSurface}"
                     VerticalAlignment="Center"
                     Text="{Binding Loc.RenameTitle}" />
          <TextBox Grid.Column="1"
                   Watermark="{Binding Loc.RenamePlaceholder}"
                   Text="{Binding RenameNewName}" />
          <Button Grid.Column="2"
                  Classes="m3-filled m3-compact"
                  Content="{Binding Loc.RenameConfirmButton}"
                  Command="{Binding ConfirmRenameCommand}" />
          <Button Grid.Column="3"
                  Classes="m3-outlined m3-compact"
                  Content="{Binding Loc.CancelButton}"
                  Command="{Binding CancelRenameCommand}" />
        </Grid>
      </Border>

      <!-- Inline move-to-folder bar -->
      <Border Classes="m3-card"
              Padding="12,10"
              IsVisible="{Binding IsMoveOpen}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource M3OnSurface}"
                     VerticalAlignment="Center"
                     Text="{Binding Loc.MoveTitle}" />
          <ComboBox Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding MoveDestinations}"
                    SelectedIndex="{Binding SelectedMoveDestinationIndex}" />
          <Button Grid.Column="2"
                  Classes="m3-filled m3-compact"
                  Content="{Binding Loc.MoveConfirmButton}"
                  Command="{Binding ConfirmMoveCommand}" />
          <Button Grid.Column="3"
                  Classes="m3-outlined m3-compact"
                  Content="{Binding Loc.CancelButton}"
                  Command="{Binding CancelMoveCommand}" />
        </Grid>
      </Border>

      <!-- Inline folder customization panel (alias, color, and symbol) -->
      <Border Classes="m3-card"
              Padding="16,14"
              IsVisible="{Binding IsCustomizeFolderOpen}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Loc.CustomizeFolderButton}" />
              <TextBlock Classes="m3-meta" FontSize="12.5" Text="•" />
              <TextBlock Classes="m3-meta" FontSize="12.5" Text="{Binding CustomizeTargetTitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="m3-text m3-icon"
                    FontSize="12"
                    Content="✕"
                    Command="{Binding CancelFolderCustomizationCommand}" />
          </Grid>

          <Grid ColumnDefinitions="240,*" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariant}" Text="{Binding Loc.CustomizeAliasLabel}" />
              <TextBox Watermark="{Binding Loc.CustomizeAliasWatermark}" Text="{Binding CustomizeEditAlias}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariant}" Text="{Binding Loc.CustomizeColorLabel}" />
              <ItemsControl ItemsSource="{Binding CustomizeColorChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderColorChoice">
                    <Button Classes="m3-text"
                            MinHeight="0"
                            Padding="3"
                            Margin="0,0,6,2"
                            Command="{Binding SelectCommand}">
                      <Border Width="22"
                              Height="22"
                              CornerRadius="11"
                              Background="{Binding Brush}"
                              BorderBrush="{Binding SelectionBorderBrush}"
                              BorderThickness="2" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariant}" Text="{Binding Loc.CustomizeIconLabel}" />
            <ItemsControl ItemsSource="{Binding CustomizeIconChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderIconChoice">
                  <Button Padding="10,5"
                          Margin="0,0,6,4"
                          Background="{DynamicResource M3SurfaceContainerHigh}"
                          BorderBrush="{Binding SelectionBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="12"
                          Command="{Binding SelectCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="13" Height="13"
                                Foreground="{DynamicResource M3OnSurface}"
                                Data="{Binding Geometry}" />
                      <TextBlock FontSize="11.5"
                                 Foreground="{DynamicResource M3OnSurface}"
                                 VerticalAlignment="Center"
                                 Text="{Binding Label}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <Button Classes="m3-filled m3-compact"
                    Margin="0,0,8,0"
                    Content="{Binding Loc.SaveCustomizationButton}"
                    Command="{Binding SaveFolderCustomizationCommand}" />
            <Button Classes="m3-tonal m3-compact"
                    Margin="0,0,8,0"
                    Content="{Binding Loc.ResetCustomizationButton}"
                    Command="{Binding ResetFolderCustomizationCommand}" />
            <Button Classes="m3-outlined m3-compact"
                    Content="{Binding Loc.CancelButton}"
                    Command="{Binding CancelFolderCustomizationCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Transfer error banner -->
      <Border Classes="m3-banner-error"
              IsVisible="{Binding HasTransferErrorBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <PathIcon Grid.Column="0"
                    Classes="m3-error-pulse"
                    Width="15" Height="15"
                    Foreground="{DynamicResource M3ErrorAccent}"
                    VerticalAlignment="Center"
                    Data="{StaticResource TundraAlertGeometry}">
            <PathIcon.RenderTransform>
              <TranslateTransform />
            </PathIcon.RenderTransform>
          </PathIcon>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource M3OnErrorContainer}"
                     TextWrapping="Wrap"
                     Text="{Binding TransferErrorBannerText}" />
          <Button Grid.Column="2"
                  Classes="m3-text m3-icon"
                  FontSize="12"
                  Content="✕"
                  Command="{Binding DismissTransferErrorBannerCommand}" />
        </Grid>
      </Border>

      <!-- Contextual selection bar (shown only when items are selected) -->
      <Border Classes="m3-card-elevated"
              Padding="12,8"
              IsVisible="{Binding ShowSelectionBar}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Grid.Column="0"
                  Background="{DynamicResource M3SecondaryContainer}"
                  CornerRadius="14"
                  Padding="10,4"
                  VerticalAlignment="Center"
                  IsVisible="{Binding SelectionCountDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource M3OnSecondaryContainer}"
                       Text="{Binding SelectionCountDisplay}" />
          </Border>

          <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="m3-tonal m3-compact"
                    Margin="0,0,6,0"
                    Content="{Binding Loc.PreviewButton}"
                    IsVisible="{Binding CanPreviewSelected}"
                    Command="{Binding PreviewSelectedCommand}" />
            <Button Classes="m3-tonal m3-compact"
                    Margin="0,0,6,0"
                    Content="{Binding Loc.DownloadButton}"
                    IsVisible="{Binding CanDownloadSelected}"
                    Command="{Binding DownloadSelectedCommand}" />
            <Button Classes="m3-tonal m3-compact"
                    Margin="0,0,6,0"
                    Content="{Binding Loc.CustomizeFolderButton}"
                    IsVisible="{Binding CanCustomizeSelectedFolder}"
                    Command="{Binding OpenCustomizeFolderCommand}" />
            <Button Classes="m3-tonal m3-compact"
                    Margin="0,0,6,0"
                    IsVisible="{Binding CanToggleFavoriteSelected}"
                    Command="{Binding ToggleFavoriteSelectedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Width="12" Height="12" Foreground="{DynamicResource M3Warning}" Data="{StaticResource TundraStarGeometry}" />
                <TextBlock Text="{Binding FavoriteSelectedLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="m3-text m3-compact"
                    Margin="0,0,6,0"
                    Content="{Binding Loc.OpenInDriveButton}"
                    IsVisible="{Binding CanOpenSelectedInDrive}"
                    Command="{Binding OpenSelectedInDriveCommand}" />
            <Button Classes="m3-text m3-compact"
                    Margin="0,0,6,0"
                    Content="{Binding Loc.RenameButton}"
                    IsVisible="{Binding CanRenameSelected}"
                    Command="{Binding OpenRenameCommand}" />
            <Button Classes="m3-text m3-compact"
                    Margin="0,0,6,0"
                    Content="{Binding Loc.MoveToFolderButton}"
                    IsVisible="{Binding CanMoveSelected}"
                    Command="{Binding OpenMoveCommand}" />
            <Button Classes="m3-danger-outlined m3-compact"
                    Margin="0,0,6,0"
                    Content="{Binding Loc.MoveToTrashButton}"
                    IsVisible="{Binding CanTrashSelected}"
                    Command="{Binding TrashSelectedCommand}" />
          </WrapPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="m3-text m3-compact"
                    Content="{Binding Loc.SelectAllButton}"
                    IsEnabled="{Binding !IsFolderEmpty}"
                    Click="OnSelectAllClick" />
            <Button Classes="m3-text m3-icon"
                    MinHeight="28"
                    MinWidth="28"
                    FontSize="12"
                    Content="✕"
                    ToolTip.Tip="{Binding Loc.ClearSelectionButton}"
                    Click="OnClearSelectionClick" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Dedicated trash actions bar -->
      <Border Classes="m3-banner-error"
              Padding="14,10"
              IsVisible="{Binding IsTrashView}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <PathIcon Grid.Column="0" Width="15" Height="15" Foreground="{DynamicResource M3Error}" Data="{StaticResource TundraTrashGeometry}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock FontSize="12.5"
                       Foreground="{DynamicResource M3OnErrorContainer}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding Loc.TrashBannerTitle}" />
            <Border Background="{DynamicResource M3SurfaceContainerHigh}"
                    CornerRadius="16"
                    Padding="10,3"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasMultipleSelected}">
              <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding SelectionCountDisplay}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="m3-text m3-compact"
                    Content="{Binding Loc.SelectAllButton}"
                    IsEnabled="{Binding !IsFolderEmpty}"
                    Click="OnSelectAllClick" />
            <Button Classes="m3-outlined m3-compact"
                    Content="{Binding Loc.PreviewButton}"
                    IsVisible="{Binding CanPreviewSelected}"
                    Command="{Binding PreviewSelectedCommand}" />
            <Button Classes="m3-tonal m3-compact"
                    Content="{Binding Loc.RestoreFromTrashButton}"
                    IsVisible="{Binding CanRestoreSelected}"
                    Command="{Binding RestoreSelectedCommand}" />
            <Button Classes="m3-danger-outlined m3-compact"
                    Content="{Binding Loc.DeletePermanentlyButton}"
                    IsVisible="{Binding CanDeleteSelectedPermanently}"
                    Command="{Binding DeleteSelectedPermanentlyCommand}" />
            <Button Classes="m3-danger-tonal m3-compact"
                    Content="{Binding Loc.EmptyTrashButton}"
                    IsEnabled="{Binding CanEmptyTrash}"
                    Command="{Binding RequestEmptyTrashCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="m3-dialog"
              CornerRadius="16"
              Padding="14,10"
              Background="{DynamicResource M3ErrorContainer}"
              IsVisible="{Binding IsEmptyTrashConfirmVisible}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     FontSize="12.5"
                     FontWeight="Medium"
                     Foreground="{DynamicResource M3OnErrorContainer}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{Binding Loc.EmptyTrashConfirmTitle}" />
          <Button Grid.Column="1"
                  Classes="m3-outlined m3-compact"
                  Content="{Binding Loc.CancelButton}"
                  Command="{Binding CancelEmptyTrashCommand}" />
          <Button Grid.Column="2"
                  Classes="m3-danger-tonal m3-compact"
                  Content="{Binding Loc.ConfirmButton}"
                  Command="{Binding ConfirmEmptyTrashCommand}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- File list/grid surface and side preview panel -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Grid Grid.Column="0" Background="Transparent">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding SelectedItem.PreviewLabel, FallbackValue=''}"
                      IsVisible="{Binding CanPreviewSelected}"
                      Command="{Binding PreviewSelectedCommand}" />
            <MenuItem Header="{Binding Loc.DownloadButton}"
                      IsVisible="{Binding CanDownloadSelected}"
                      Command="{Binding DownloadSelectedCommand}" />
            <MenuItem Header="{Binding SelectedItem.ActionLabel, FallbackValue=''}"
                      IsVisible="{Binding SelectedItem.CanOpenNormal, FallbackValue=False}"
                      Command="{Binding SelectedItem.OpenActionCommand}" />
            <MenuItem Header="{Binding Loc.CustomizeFolderButton}"
                      IsVisible="{Binding CanCustomizeSelectedFolder}"
                      Command="{Binding OpenCustomizeFolderCommand}" />
            <MenuItem Header="{Binding Loc.RenameButton}"
                      IsVisible="{Binding CanRenameSelected}"
                      Command="{Binding OpenRenameCommand}" />
            <MenuItem Header="{Binding Loc.MoveToFolderButton}"
                      IsVisible="{Binding CanMoveSelected}"
                      Command="{Binding OpenMoveCommand}" />
            <MenuItem Header="{Binding FavoriteSelectedLabel}"
                      IsVisible="{Binding CanToggleFavoriteSelected}"
                      Command="{Binding ToggleFavoriteSelectedCommand}">
              <MenuItem.Icon>
                <PathIcon Width="13" Height="13" Foreground="{DynamicResource M3Warning}" Data="{StaticResource TundraStarGeometry}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding SelectedItem.OpenInDriveLabel, FallbackValue=''}"
                      IsVisible="{Binding SelectedItem.CanCopyDriveLink, FallbackValue=False}"
                      Command="{Binding SelectedItem.OpenInDriveCommand}" />
            <Separator IsVisible="{Binding SelectedItem.CanOpenNormal, FallbackValue=False}" />
            <MenuItem Header="{Binding SelectedItem.CopyNameLabel, FallbackValue=''}"
                      IsVisible="{Binding HasSelectedItem}"
                      Command="{Binding SelectedItem.CopyNameCommand}" />
            <MenuItem Header="{Binding SelectedItem.CopyLinkLabel, FallbackValue=''}"
                      IsVisible="{Binding SelectedItem.CanCopyDriveLink, FallbackValue=False}"
                      Command="{Binding SelectedItem.CopyDriveLinkCommand}" />
            <MenuItem Foreground="{DynamicResource M3Error}"
                      FontWeight="SemiBold"
                      Header="{Binding Loc.MoveToTrashButton}"
                      IsVisible="{Binding CanTrashSelected}"
                      Command="{Binding TrashSelectedCommand}">
              <MenuItem.Icon>
                <PathIcon Width="13" Height="13" Foreground="{DynamicResource M3ErrorAccent}" Data="{StaticResource TundraTrashGeometry}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding Loc.RestoreFromTrashButton}"
                      IsVisible="{Binding CanRestoreSelected}"
                      Command="{Binding RestoreSelectedCommand}" />
            <MenuItem Foreground="{DynamicResource M3Error}"
                      FontWeight="SemiBold"
                      Header="{Binding Loc.DeletePermanentlyButton}"
                      IsVisible="{Binding CanDeleteSelectedPermanently}"
                      Command="{Binding DeleteSelectedPermanentlyCommand}" />
            <Separator IsVisible="{Binding HasSelectedItem}" />
            <MenuItem Header="{Binding Loc.NewFolderButton}"
                      IsVisible="{Binding !IsTrashView}"
                      Command="{Binding OpenCreateFolderCommand}" />
            <MenuItem Header="{Binding Loc.UploadFileButton}"
                      IsVisible="{Binding !IsTrashView}"
                      Command="{Binding UploadFileCommand}" />
            <MenuItem Header="{Binding Loc.RefreshButton}"
                      Command="{Binding RefreshCommand}" />
            <MenuItem Header="{Binding Loc.BackButton}"
                      IsVisible="{Binding CanNavigateBack}"
                      Command="{Binding NavigateBackCommand}" />
            <Separator IsVisible="{Binding !IsFolderEmpty}" />
            <MenuItem Header="{Binding Loc.SelectAllButton}"
                      IsVisible="{Binding !IsFolderEmpty}"
                      Click="OnSelectAllClick" />
            <MenuItem Header="{Binding Loc.ClearSelectionButton}"
                      IsVisible="{Binding HasSelectedItem}"
                      Click="OnClearSelectionClick" />
            <MenuItem Foreground="{DynamicResource M3Error}"
                      FontWeight="SemiBold"
                      Header="{Binding Loc.EmptyTrashButton}"
                      IsVisible="{Binding CanEmptyTrash}"
                      Command="{Binding RequestEmptyTrashCommand}" />
          </ContextMenu>
        </Grid.ContextMenu>

        <!-- List layout -->
        <Border Classes="m3-card" Padding="0" ClipToBounds="True" IsVisible="{Binding !IsGridLayout}">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0">
              <Border Padding="16,10">
                <Grid ColumnDefinitions="28,*,32,110,90,135" ColumnSpacing="8">
                  <TextBlock Grid.Column="1" Classes="m3-meta" Text="{Binding Loc.ColName}" />
                  <TextBlock Grid.Column="3" Classes="m3-meta" Text="{Binding Loc.ColOrigin}" />
                  <TextBlock Grid.Column="4" Classes="m3-meta" Text="{Binding Loc.ColSize}" />
                  <TextBlock Grid.Column="5" Classes="m3-meta" Text="{Binding Loc.ColModified}" />
                </Grid>
              </Border>
              <Border Classes="m3-divider-full" />
            </StackPanel>

            <ListBox x:Name="ListFilesListBox"
                     Grid.Row="1"
                     Classes="m3-rows"
                     SelectionMode="Multiple"
                     ItemsSource="{Binding ActiveListFiles}"
                     SelectedItem="{Binding SelectedItem}"
                     SelectionChanged="OnFileSelectionChanged"
                     DoubleTapped="OnListDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileHubItemViewModel">
                  <Border Padding="16,10" Background="Transparent">
                    <Grid ColumnDefinitions="28,*,32,110,90,135" ColumnSpacing="8">
                      <CheckBox Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MinWidth="0" MinHeight="0" Padding="0"
                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                Click="OnItemCheckBoxClick" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Width="15" Height="15"
                                    Foreground="{Binding FileIconBrush}"
                                    Data="{Binding FileIconData}" />
                          <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource M3OnSurface}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Classes="m3-meta" FontSize="11" Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <Button Grid.Column="2"
                              Classes="m3-text m3-icon"
                              MinWidth="26"
                              MinHeight="26"
                              Padding="3"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding CanToggleFavorite}"
                              ToolTip.Tip="{Binding FavoriteTooltip}"
                              Command="{Binding ToggleFavoriteCommand}">
                        <PathIcon Width="13" Height="13"
                                  Foreground="{Binding FavoriteIconBrush}"
                                  Data="{Binding FavoriteIconData}" />
                      </Button>

                      <TextBlock Grid.Column="3"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding OriginBrush}"
                                 Text="{Binding OriginDisplay}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="4" Classes="m3-meta" VerticalAlignment="Center" Text="{Binding SizeDisplay}" />
                      <TextBlock Grid.Column="5" Classes="m3-meta" VerticalAlignment="Center" Text="{Binding ModifiedDisplay}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- Sectioned grid layout (compact folder pills + clean file cards) -->
        <ScrollViewer IsVisible="{Binding IsGridLayout}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18" Margin="0,4,0,8">
            <StackPanel Spacing="10" IsVisible="{Binding HasGridFolders}">
              <TextBlock Classes="m3-group-label" Text="{Binding Loc.FileHubFoldersSection}" />
              <ListBox x:Name="GridFoldersListBox"
                       Classes="m3-grid m3-grid-folders"
                       SelectionMode="Multiple"
                       ItemsSource="{Binding GridFolders}"
                       SelectionChanged="OnGridFoldersSelectionChanged"
                       DoubleTapped="OnListDoubleTapped">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FileHubItemViewModel">
                    <Border Width="228" MinHeight="56" Padding="12,10" Background="Transparent" ToolTip.Tip="{Binding Name}">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <PathIcon Grid.Column="0"
                                  Width="22" Height="22"
                                  VerticalAlignment="Center"
                                  Foreground="{Binding FileIconBrush}"
                                  Data="{Binding FileIconData}" />

                        <TextBlock Grid.Column="1"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource M3OnSurface}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}" />

                        <Button Grid.Column="2"
                                Classes="m3-text m3-icon m3-grid-star"
                                Classes.m3-star-active="{Binding IsStarred}"
                                MinWidth="24"
                                MinHeight="24"
                                Padding="3"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanToggleFavorite}"
                                ToolTip.Tip="{Binding FavoriteTooltip}"
                                Command="{Binding ToggleFavoriteCommand}">
                          <PathIcon Width="13" Height="13"
                                    Foreground="{Binding FavoriteIconBrush}"
                                    Data="{Binding FavoriteIconData}" />
                        </Button>

                        <CheckBox Grid.Column="3"
                                  Classes="m3-grid-check"
                                  Classes.m3-check-visible="{Binding #FileHubRoot.((vm:FileHubViewModel)DataContext).HasSelectedItem, FallbackValue=False}"
                                  VerticalAlignment="Center"
                                  MinWidth="0" MinHeight="0" Padding="0"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Click="OnItemCheckBoxClick" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding HasGridFiles}">
              <TextBlock Classes="m3-group-label" Text="{Binding Loc.FileHubFilesSection}" />
              <ListBox x:Name="GridFilesListBox"
                       Classes="m3-grid m3-grid-files"
                       SelectionMode="Multiple"
                       ItemsSource="{Binding GridFileItems}"
                       SelectionChanged="OnGridFilesSelectionChanged"
                       DoubleTapped="OnListDoubleTapped">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FileHubItemViewModel">
                    <Border Width="188" Height="174" Padding="10" Background="Transparent" ToolTip.Tip="{Binding Name}">
                      <Grid RowDefinitions="*,Auto" RowSpacing="8">
                        <Grid Grid.Row="0">
                          <Border CornerRadius="10"
                                  ClipToBounds="True"
                                  IsVisible="{Binding HasThumbnail}">
                            <Grid>
                              <Image Source="{Binding ThumbnailBitmap}"
                                     Stretch="UniformToFill" />
                              <Border Width="34" Height="34"
                                      CornerRadius="17"
                                      Background="{DynamicResource M3Scrim}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding IsVideoFile}">
                                <PathIcon Width="14" Height="14"
                                          Foreground="{DynamicResource M3OnSurface}"
                                          Data="M8 5v14l11-7z" />
                              </Border>
                            </Grid>
                          </Border>

                          <Border Width="64" Height="64"
                                  CornerRadius="18"
                                  Background="{DynamicResource M3SurfaceContainerHigh}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding !HasThumbnail}">
                            <PathIcon Width="30" Height="30"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding FileIconBrush}"
                                      Data="{Binding FileIconData}" />
                          </Border>

                          <CheckBox Classes="m3-grid-check"
                                    Classes.m3-check-visible="{Binding #FileHubRoot.((vm:FileHubViewModel)DataContext).HasSelectedItem, FallbackValue=False}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="2"
                                    MinWidth="0" MinHeight="0" Padding="0"
                                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                                    Click="OnItemCheckBoxClick" />

                          <Button Classes="m3-text m3-icon m3-grid-star"
                                  Classes.m3-star-active="{Binding IsStarred}"
                                  MinWidth="26"
                                  MinHeight="26"
                                  Padding="4"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="2"
                                  IsVisible="{Binding CanToggleFavorite}"
                                  ToolTip.Tip="{Binding FavoriteTooltip}"
                                  Command="{Binding ToggleFavoriteCommand}">
                            <PathIcon Width="13" Height="13"
                                      Foreground="{Binding FavoriteIconBrush}"
                                      Data="{Binding FavoriteIconData}" />
                          </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="2">
                          <TextBlock FontSize="12.5"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource M3OnSurface}"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center"
                                     TextWrapping="Wrap"
                                     MaxLines="2"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Name}" />
                          <TextBlock Classes="m3-meta"
                                     FontSize="11"
                                     HorizontalAlignment="Center"
                                     Text="{Binding SizeDisplay}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ProgressBar VerticalAlignment="Top"
                     Height="3"
                     CornerRadius="0"
                     IsIndeterminate="True"
                     IsHitTestVisible="False"
                     IsVisible="{Binding IsLoading}" />

        <TextBlock VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Classes="m3-subtitle"
                   IsHitTestVisible="False"
                   Text="{Binding EmptyStateText}"
                   IsVisible="{Binding IsFolderEmpty}" />
      </Grid>

      <!-- Side preview panel -->
      <Border Grid.Column="1"
              Width="320"
              Classes="m3-card"
              IsVisible="{Binding IsPreviewVisible}">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="m3-section-title" Text="{Binding Loc.PreviewTitle}" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="m3-text m3-icon"
                    Content="✕"
                    Command="{Binding ClosePreviewCommand}" />
          </Grid>

          <Border Grid.Row="1"
                  Classes="m3-card-inset"
                  Padding="10">
            <Grid>
              <Image Source="{Binding PreviewBitmap}"
                     Stretch="Uniform"
                     IsVisible="{Binding HasVisualBitmap}" />

              <TextBox IsReadOnly="True"
                       AcceptsReturn="True"
                       FontFamily="monospace"
                       FontSize="11.5"
                       Background="Transparent"
                       BorderThickness="0"
                       Text="{Binding PreviewTextContent}"
                       IsVisible="{Binding IsTextPreview}" />

              <TextBlock VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Classes="m3-meta"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Text="{Binding PreviewMessage}"
                         IsVisible="{Binding PreviewMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Spacing="3">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding PreviewFileName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="m3-meta" FontSize="11.5" Text="{Binding PreviewMetaText}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="3" Spacing="8">
            <Button Classes="m3-tonal"
                    HorizontalAlignment="Stretch"
                    Content="{Binding AudioToggleLabel}"
                    IsVisible="{Binding IsAudioPreview}"
                    Command="{Binding ToggleAudioPlaybackCommand}" />

            <Button Classes="m3-tonal"
                    HorizontalAlignment="Stretch"
                    Content="{Binding Loc.PreviewPlayVideo}"
                    IsVisible="{Binding IsVideoPreview}"
                    Command="{Binding PlayVideoCommand}" />

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding IsPdfPreview}">
              <Button Grid.Column="0"
                      Classes="m3-outlined m3-compact"
                      IsEnabled="{Binding CanPreviousPdfPage}"
                      Content="{Binding Loc.PreviewPrevPage}"
                      Command="{Binding PreviousPdfPageCommand}" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Classes="m3-meta"
                         Text="{Binding PdfPageDisplay}" />
              <Button Grid.Column="2"
                      Classes="m3-outlined m3-compact"
                      IsEnabled="{Binding CanNextPdfPage}"
                      Content="{Binding Loc.PreviewNextPage}"
                      Command="{Binding NextPdfPageCommand}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0"
                      Classes="m3-tonal"
                      HorizontalAlignment="Stretch"
                      Content="{Binding Loc.DownloadButton}"
                      Command="{Binding DownloadPreviewedItemCommand}" />
              <Button Grid.Column="1"
                      Classes="m3-filled"
                      HorizontalAlignment="Stretch"
                      Content="{Binding Loc.FileHubOpenLocal}"
                      Command="{Binding OpenPreviewedItemCommand}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Status footer and pagination -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Grid.Column="0" Classes="m3-meta" VerticalAlignment="Center" Text="{Binding StatusSummary}" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasMultiplePages}">
        <Button Classes="m3-outlined m3-compact"
                FontSize="11.5"
                Content="◀"
                IsEnabled="{Binding CanPreviousPage}"
                Command="{Binding PreviousPageCommand}" />
        <TextBlock Classes="m3-meta"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Text="{Binding PageDisplay}" />
        <Button Classes="m3-outlined m3-compact"
                FontSize="11.5"
                Content="▶"
                IsEnabled="{Binding CanNextPage}"
                Command="{Binding NextPageCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

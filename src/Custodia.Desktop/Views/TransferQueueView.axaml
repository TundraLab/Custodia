<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Class="TundraDrive.Desktop.Views.TransferQueueView"
             x:DataType="vm:TransferQueueViewModel">

  <!-- Transfer queue tab -->
  <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
    <!-- Compact header -->
    <Grid Grid.Row="0" MinHeight="48" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
        <TextBlock Classes="m3-page-title" Text="{Binding Loc.TransferQueueTitle}" />
        <TextBlock Classes="m3-subtitle" Text="{Binding SummaryText}" TextWrapping="Wrap" />
      </StackPanel>

      <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Classes="m3-danger-outlined"
                Margin="0,0,8,0"
                Content="{Binding Loc.CancelButton}"
                IsEnabled="{Binding CanCancelSelected}"
                Command="{Binding CancelSelectedCommand}" />
        <Button Classes="m3-tonal"
                Content="{Binding Loc.ClearCompletedButton}"
                Command="{Binding ClearCompletedCommand}" />
      </WrapPanel>
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12">
      <!-- Latest transfer error banner -->
      <Border Grid.Row="0"
              Classes="m3-banner-error"
              IsVisible="{Binding HasLastErrorBanner}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <PathIcon Grid.Column="0"
                    Classes="m3-error-pulse"
                    Width="16" Height="16"
                    Foreground="{DynamicResource M3ErrorAccent}"
                    VerticalAlignment="Center"
                    Data="{StaticResource TundraAlertGeometry}">
            <PathIcon.RenderTransform>
              <TranslateTransform />
            </PathIcon.RenderTransform>
          </PathIcon>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource M3OnErrorContainer}"
                     TextWrapping="Wrap"
                     Text="{Binding LastErrorMessage}" />
          <Button Grid.Column="2"
                  Classes="m3-text m3-icon"
                  FontSize="12"
                  Content="✕"
                  Command="{Binding DismissLastErrorBannerCommand}" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <Border Classes="m3-card" IsVisible="{Binding HasNoItems}">
            <TextBlock Classes="m3-subtitle" Text="{Binding Loc.NoTransfersHint}" TextWrapping="Wrap" />
          </Border>

          <ListBox Classes="m3-cards"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TransferItemViewModel">
                <Border Padding="16,14" Background="Transparent">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{Binding Loc.CancelButton}"
                                IsVisible="{Binding CanCancel}"
                                Command="{Binding CancelCommand}" />
                      <MenuItem Header="{Binding Loc.CopyNameMenu}"
                                Command="{Binding CopyNameCommand}" />
                      <MenuItem Header="{Binding Loc.CopyTargetPathMenu}"
                                Command="{Binding CopyPathCommand}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="12">
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                      <!-- Animated icons for active transfers -->
                      <PathIcon Classes="m3-upload-pulse"
                                Width="15" Height="15"
                                Foreground="{DynamicResource M3Primary}"
                                IsVisible="{Binding IsUploadingActive}"
                                Data="{StaticResource TundraUploadGeometry}">
                        <PathIcon.RenderTransform>
                          <TranslateTransform />
                        </PathIcon.RenderTransform>
                      </PathIcon>
                      <PathIcon Classes="m3-download-pulse"
                                Width="15" Height="15"
                                Foreground="{DynamicResource M3Success}"
                                IsVisible="{Binding IsDownloadingActive}"
                                Data="{StaticResource TundraDownloadGeometry}">
                        <PathIcon.RenderTransform>
                          <TranslateTransform />
                        </PathIcon.RenderTransform>
                      </PathIcon>
                      <PathIcon Classes="m3-delete-pulse"
                                Width="15" Height="15"
                                Foreground="{DynamicResource M3ErrorAccent}"
                                IsVisible="{Binding IsDeletingActive}"
                                Data="{StaticResource TundraTrashGeometry}">
                        <PathIcon.RenderTransform>
                          <TranslateTransform />
                        </PathIcon.RenderTransform>
                      </PathIcon>
                      <PathIcon Classes="m3-error-pulse"
                                Width="15" Height="15"
                                Foreground="{DynamicResource M3ErrorAccent}"
                                IsVisible="{Binding IsFailedActive}"
                                Data="{StaticResource TundraAlertGeometry}">
                        <PathIcon.RenderTransform>
                          <TranslateTransform />
                        </PathIcon.RenderTransform>
                      </PathIcon>

                      <!-- Static icons for finished transfers -->
                      <PathIcon Width="15" Height="15"
                                Foreground="{DynamicResource M3Primary}"
                                Opacity="0.82"
                                IsVisible="{Binding IsUploadingStatic}"
                                Data="{StaticResource TundraUploadGeometry}" />
                      <PathIcon Width="15" Height="15"
                                Foreground="{DynamicResource M3Success}"
                                Opacity="0.82"
                                IsVisible="{Binding IsDownloadingStatic}"
                                Data="{StaticResource TundraDownloadGeometry}" />
                      <PathIcon Width="15" Height="15"
                                Foreground="{DynamicResource M3ErrorAccent}"
                                Opacity="0.82"
                                IsVisible="{Binding IsDeletingStatic}"
                                Data="{StaticResource TundraTrashGeometry}" />
                      <PathIcon Width="15" Height="15"
                                Foreground="{DynamicResource M3ErrorAccent}"
                                Opacity="0.92"
                                IsVisible="{Binding IsFailedStatic}"
                                Data="{StaticResource TundraAlertGeometry}" />

                      <StackPanel Spacing="2">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding FileName}" TextWrapping="Wrap" />
                        <TextBlock Classes="m3-meta" Text="{Binding SubtitleText}" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="m3-meta" FontSize="11.5" Text="{Binding TimestampDisplay}" VerticalAlignment="Center" />
                      <TextBlock Classes="m3-meta" FontSize="11.5" Text="•" VerticalAlignment="Center" />
                      <Border Width="8" Height="8" CornerRadius="4" Background="{Binding AccentBorderBrush}" VerticalAlignment="Center" />
                      <TextBlock Classes="m3-meta" Text="{Binding DirectionDisplay}" />
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                 Minimum="0" Maximum="100"
                                 Foreground="{Binding TransferProgressBrush}"
                                 Value="{Binding ProgressPercentage}" />

                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Grid.Column="0" Classes="m3-meta" Text="{Binding StatusDisplay}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="m3-meta" Text="{Binding ProgressDisplay}" />
                    </Grid>

                    <!-- Inline error notice for failed transfers -->
                    <Border Grid.Row="3" Grid.ColumnSpan="2"
                            Margin="0,2,0,0"
                            Padding="12,8"
                            CornerRadius="12"
                            Background="{DynamicResource M3ErrorContainer}"
                            BorderThickness="0"
                            IsVisible="{Binding IsFailed}">
                      <TextBlock FontSize="12"
                                 Foreground="{DynamicResource M3OnErrorContainer}"
                                 TextWrapping="Wrap"
                                 Text="{Binding ErrorHeadlineText}" />
                    </Border>

                    <!-- Expandable details panel on card selection -->
                    <Border Grid.Row="4" Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            Classes="m3-card-inset"
                            IsVisible="{Binding IsSelected}">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="4">
                          <TextBlock Grid.Row="0" Grid.Column="0" Classes="m3-meta" Text="{Binding Loc.TransferDetailLocalPath}" IsVisible="{Binding HasLocalPath}" />
                          <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="{DynamicResource M3OnSurface}" Text="{Binding LocalPath}" TextWrapping="Wrap" IsVisible="{Binding HasLocalPath}" />

                          <TextBlock Grid.Row="1" Grid.Column="0" Classes="m3-meta" Text="{Binding Loc.TransferDetailRelativePath}" />
                          <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{DynamicResource M3OnSurface}" Text="{Binding RelativePath}" TextWrapping="Wrap" />

                          <TextBlock Grid.Row="2" Grid.Column="0" Classes="m3-meta" Text="{Binding Loc.TransferDetailRemoteId}" IsVisible="{Binding HasRemoteFileId}" />
                          <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" FontFamily="monospace" Foreground="{DynamicResource M3OnSurfaceVariant}" Text="{Binding RemoteFileId}" TextWrapping="Wrap" IsVisible="{Binding HasRemoteFileId}" />

                          <TextBlock Grid.Row="3" Grid.Column="0" Classes="m3-meta" Text="{Binding Loc.TransferDetailStarted}" />
                          <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{DynamicResource M3OnSurface}" Text="{Binding StartedDisplay}" />

                          <TextBlock Grid.Row="4" Grid.Column="0" Classes="m3-meta" Text="{Binding Loc.TransferDetailCompleted}" IsVisible="{Binding HasCompletedTime}" />
                          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasCompletedTime}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource M3OnSurface}" Text="{Binding CompletedDisplay}" />
                            <TextBlock Classes="m3-meta" Text="•" />
                            <TextBlock Classes="m3-meta" Text="{Binding Loc.TransferDetailDuration}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource M3OnSurface}" Text="{Binding DurationDisplay}" />
                            <TextBlock Classes="m3-meta" Text="•" IsVisible="{Binding HasSpeedDisplay}" />
                            <TextBlock Classes="m3-meta" Text="{Binding Loc.TransferDetailAvgSpeed}" IsVisible="{Binding HasSpeedDisplay}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource M3Tertiary}" Text="{Binding SpeedDisplay}" IsVisible="{Binding HasSpeedDisplay}" />
                          </StackPanel>

                          <TextBlock Grid.Row="5" Grid.Column="0" Classes="m3-meta" Foreground="{DynamicResource M3Error}" Text="{Binding Loc.TransferDetailError}" IsVisible="{Binding HasError}" />
                          <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" Foreground="{DynamicResource M3Error}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal">
                          <Button Classes="m3-outlined m3-compact"
                                  Margin="0,0,8,4"
                                  Content="{Binding Loc.OpenLocalFolderMenu}"
                                  IsVisible="{Binding HasLocalPath}"
                                  Command="{Binding OpenFolderCommand}" />
                          <Button Classes="m3-outlined m3-compact"
                                  Margin="0,0,8,4"
                                  Content="{Binding Loc.TransferCopyPathButton}"
                                  IsVisible="{Binding HasLocalPath}"
                                  Command="{Binding CopyPathCommand}" />
                          <Button Classes="m3-outlined m3-compact"
                                  Margin="0,0,8,4"
                                  Content="{Binding Loc.TransferCopyDriveIdButton}"
                                  IsVisible="{Binding HasRemoteFileId}"
                                  Command="{Binding CopyRemoteIdCommand}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>

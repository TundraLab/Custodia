<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Class="TundraDrive.Desktop.Views.AboutView"
             x:DataType="vm:AboutViewModel">

  <!-- About tab -->
  <ScrollViewer Padding="24"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                AllowAutoHide="False">
    <StackPanel Spacing="18" HorizontalAlignment="Stretch">
      <!-- Compact header -->
      <StackPanel MinHeight="48" VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="m3-page-title" Text="{Binding Loc.AboutSectionTitle}" />
        <TextBlock Classes="m3-subtitle" Text="{Binding Loc.AboutVersionLabel}" />
      </StackPanel>

      <!-- Application identity card -->
      <Border Classes="m3-card">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Image Grid.Column="0"
                   Source="avares://Custodia/Assets/custodia-icon.png"
                   Width="64"
                   Height="64"
                   VerticalAlignment="Center"
                   Stretch="Uniform" />

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="Custódia" />
              <TextBlock Classes="m3-subtitle"
                         TextWrapping="Wrap"
                         Text="{Binding Loc.AboutDescription}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="m3-outlined"
                    VerticalAlignment="Top"
                    Command="{Binding OpenRepositoryCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="15" Height="15"
                          Foreground="{DynamicResource M3OnSurface}"
                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                <TextBlock Text="GitHub • TundraLab/Custodia" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <WrapPanel Orientation="Horizontal">
            <Button Classes="m3-outlined m3-compact"
                    Margin="0,0,8,4"
                    Content="{Binding Loc.LegalPrivacyButton}"
                    Command="{Binding OpenPrivacyPolicyCommand}" />
            <Button Classes="m3-outlined m3-compact"
                    Margin="0,0,8,4"
                    Content="{Binding Loc.LegalTermsButton}"
                    Command="{Binding OpenTermsOfUseCommand}" />
            <Button Classes="m3-outlined m3-compact"
                    Margin="0,0,8,4"
                    Content="{Binding Loc.LegalGooglePolicyButton}"
                    Command="{Binding OpenGoogleApiPolicyCommand}" />
            <Button Classes="m3-outlined m3-compact"
                    Margin="0,0,0,4"
                    Content="{Binding Loc.LegalReviewButton}"
                    Command="{Binding ReviewLegalTermsCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Company and author metadata (Inset Grouped List) -->
      <Border Classes="m3-grouped-list">
        <StackPanel>
          <Border Classes="m3-grouped-row">
            <Grid ColumnDefinitions="130,*" ColumnSpacing="12">
              <TextBlock Grid.Column="0" Classes="m3-meta" VerticalAlignment="Center" Text="{Binding Loc.AboutCompanyLabel}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="avares://Custodia/Assets/brand-logo.png"
                       Width="20"
                       Height="20"
                       Stretch="Uniform" />
                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" VerticalAlignment="Center" Text="{Binding CompanyName}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="m3-divider" />

          <Border Classes="m3-grouped-row">
            <Grid ColumnDefinitions="130,*" ColumnSpacing="12">
              <TextBlock Grid.Column="0" Classes="m3-meta" VerticalAlignment="Center" Text="{Binding Loc.AboutDeveloperLabel}" />
              <TextBlock Grid.Column="1" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" VerticalAlignment="Center" Text="{Binding DeveloperName}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Application updates card -->
      <Border Classes="m3-card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
              <TextBlock Classes="m3-section-title" Text="{Binding Loc.UpdatesSectionTitle}" />
              <TextBlock Classes="m3-meta" FontSize="12.5" TextWrapping="Wrap" Text="{Binding InstalledModeSummary}" />
              <TextBlock Classes="m3-meta" FontSize="11.5" TextWrapping="Wrap" Text="{Binding LastCheckSummary}" />
              <TextBlock Classes="m3-meta" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource M3Primary}" Text="{Binding UpdateScheduleSummary}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="m3-tonal"
                    IsEnabled="{Binding CanCheckUpdates}"
                    Command="{Binding CheckForUpdatesCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="13" Height="13"
                          Classes.m3-spinning="{Binding IsCheckingUpdates}"
                          Foreground="{DynamicResource M3OnSecondaryContainer}"
                          Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z">
                  <PathIcon.RenderTransform>
                    <RotateTransform />
                  </PathIcon.RenderTransform>
                </PathIcon>
                <TextBlock Text="{Binding CheckUpdatesButtonText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock FontSize="12.5"
                     FontWeight="Medium"
                     TextWrapping="Wrap"
                     IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="{Binding UpdateStatusBrush}"
                     Text="{Binding UpdateStatusText}" />

          <ProgressBar Height="5"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding UpdateCheckProgress}"
                       IsVisible="{Binding IsCheckingUpdates}" />

          <ProgressBar Height="6"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding UpdateDownloadProgress}"
                       IsVisible="{Binding IsDownloadingUpdate}" />

          <WrapPanel Orientation="Horizontal"
                     IsVisible="{Binding IsUpdateAvailable}">
            <Button Classes="m3-filled"
                    Margin="0,0,10,4"
                    IsEnabled="{Binding CanInstallUpdate}"
                    Content="{Binding Loc.UpdateInstallNowButton}"
                    Command="{Binding InstallUpdateCommand}" />
            <Button Classes="m3-outlined"
                    Margin="0,0,0,4"
                    Content="{Binding Loc.UpdateOpenReleaseButton}"
                    Command="{Binding OpenReleasePageCommand}" />
          </WrapPanel>

          <Border Classes="m3-card-inset"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding HasReleaseNotes}">
            <ScrollViewer MaxHeight="220"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <TextBlock FontSize="12.5"
                         TextWrapping="Wrap"
                         LineHeight="20"
                         Foreground="{DynamicResource M3OnSurfaceVariant}"
                         Text="{Binding LatestReleaseNotes}" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <!-- Support and feedback card -->
      <Border Classes="m3-card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
              <TextBlock Classes="m3-section-title" Text="{Binding Loc.SupportSectionTitle}" />
              <TextBlock Classes="m3-meta" FontSize="12" Text="{Binding Loc.SupportSectionSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- M3 segmented pill switcher -->
            <Border Grid.Column="1"
                    Classes="m3-segmented-track"
                    Background="{DynamicResource M3SurfaceContainerHigh}"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="m3-segmented"
                        Classes.m3-seg-active="{Binding IsBugMode}"
                        Content="{Binding Loc.FeedbackTypeBug}"
                        Command="{Binding SelectBugModeCommand}" />
                <Button Classes="m3-segmented"
                        Classes.m3-seg-active="{Binding IsSuggestionMode}"
                        Content="{Binding Loc.FeedbackTypeSuggestion}"
                        Command="{Binding SelectSuggestionModeCommand}" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Unified support form -->
          <Border Classes="m3-card-inset" Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    IsVisible="{Binding IsSuggestionMode}">
                <TextBlock Grid.Column="0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="{DynamicResource M3OnSurface}"
                           VerticalAlignment="Center"
                           Text="{Binding Loc.SuggestionCategoryLabel}" />
                <ComboBox Grid.Column="1"
                          Width="240"
                          ItemsSource="{Binding SuggestionCategories}"
                          SelectedIndex="{Binding SelectedSuggestionCategoryIndex}" />
              </Grid>

              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurface}" Text="{Binding FeedbackTitleLabel}" />
              <TextBox Watermark="{Binding FeedbackTitleWatermark}" Text="{Binding FeedbackTitle}" />

              <TextBlock FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariant}" Text="{Binding FeedbackDescriptionLabel}" />
              <TextBox AcceptsReturn="True"
                       Height="88"
                       TextWrapping="Wrap"
                       Watermark="{Binding FeedbackDescriptionWatermark}"
                       Text="{Binding FeedbackDescription}" />

              <StackPanel Spacing="10" IsVisible="{Binding IsBugMode}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <CheckBox Grid.Column="0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IncludeDiagnostics}"
                            Content="{Binding Loc.BugIncludeDiagnosticsCheckbox}" />
                  <Button Grid.Column="1"
                          Classes="m3-outlined m3-compact"
                          VerticalAlignment="Center"
                          Content="{Binding PreviewDiagnosticsButtonText}"
                          Command="{Binding ToggleDiagnosticsPreviewCommand}" />
                </Grid>

                <Border Background="{DynamicResource M3Surface}"
                        CornerRadius="12"
                        BorderThickness="0"
                        Padding="12"
                        IsVisible="{Binding IsDiagnosticsPreviewOpen}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="m3-meta"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Text="{Binding Loc.DiagnosticsPreviewHeader}" />
                    <ScrollViewer MaxHeight="150"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <TextBlock FontFamily="Consolas,Liberation Mono,Menlo,monospace"
                                 FontSize="11.5"
                                 LineHeight="17"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource M3OnSurfaceVariant}"
                                 Text="{Binding DiagnosticsPreviewText}" />
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </StackPanel>

              <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Classes="m3-filled"
                        Margin="0,0,8,4"
                        Content="{Binding Loc.OpenGitHubIssueButton}"
                        Command="{Binding SubmitFeedbackGitHubCommand}" />
                <Button Classes="m3-tonal"
                        Margin="0,0,0,4"
                        Content="{Binding Loc.CopyReportButton}"
                        Command="{Binding CopyFeedbackCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="m3-meta"
                     Foreground="{DynamicResource M3Primary}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding FeedbackStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding FeedbackStatusMessage}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

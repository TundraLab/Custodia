<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <SolidColorBrush x:Key="TundraWindowBg">#111317</SolidColorBrush>
    <SolidColorBrush x:Key="TundraSidebarBg">#16191F</SolidColorBrush>
    <SolidColorBrush x:Key="TundraCardBg">#1B1F27</SolidColorBrush>
    <SolidColorBrush x:Key="TundraElevatedBg">#212630</SolidColorBrush>
    <SolidColorBrush x:Key="TundraBorderBrush">#2A303B</SolidColorBrush>
    <SolidColorBrush x:Key="TundraTextPrimary">#F0F4F8</SolidColorBrush>
    <SolidColorBrush x:Key="TundraTextSecondary">#9AA4B2</SolidColorBrush>
    <SolidColorBrush x:Key="TundraTextMuted">#6E7785</SolidColorBrush>
    <SolidColorBrush x:Key="TundraAccent">#3B82F6</SolidColorBrush>
    <SolidColorBrush x:Key="TundraAccentHover">#2563EB</SolidColorBrush>
    <SolidColorBrush x:Key="TundraDanger">#DC2626</SolidColorBrush>

    <!-- FluentTheme overrides para manter popups, menus e caixas de texto dentro da UI/UX escura -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground">#16191F</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush">#2A303B</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackground">#141820</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver">#1D2330</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBorderBrush">#2A303B</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">#475569</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver">#212630</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected">#1E293B</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver">#263449</SolidColorBrush>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground">#16191F</SolidColorBrush>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush">#2A303B</SolidColorBrush>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver">#212630</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackground">#141820</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#181D27</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundFocused">#141820</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrush">#2A303B</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#475569</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused">#3B82F6</SolidColorBrush>
  </Styles.Resources>

  <Style Selector="TextBlock.PageTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.Subtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextSecondary}" />
  </Style>

  <Style Selector="TextBlock.MutedMeta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextMuted}" />
  </Style>

  <Style Selector="Border.SurfaceCard">
    <Setter Property="Background" Value="{StaticResource TundraCardBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.FlatRow">
    <Setter Property="Background" Value="{StaticResource TundraCardBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Button.PrimaryAction">
    <Setter Property="Background" Value="{StaticResource TundraAccent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.PrimaryAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TundraAccentHover}" />
  </Style>

  <Style Selector="Button.PrimaryAction:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.PrimaryAction.SuccessAction">
    <Setter Property="Background" Value="#059669" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.PrimaryAction.SuccessAction /template/ ContentPresenter">
    <Setter Property="Background" Value="#059669" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.PrimaryAction.SuccessAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#047857" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.SecondaryAction">
    <Setter Property="Background" Value="{StaticResource TundraElevatedBg}" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.SecondaryAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A303C" />
    <Setter Property="BorderBrush" Value="#424C5E" />
  </Style>

  <Style Selector="Button.SecondaryAction:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.SecondaryAction.ReloadSuccess">
    <Setter Property="Background" Value="#112B23" />
    <Setter Property="BorderBrush" Value="#10B981" />
    <Setter Property="Foreground" Value="#6EE7B7" />
  </Style>

  <Style Selector="Button.SecondaryAction.ReloadSuccess /template/ ContentPresenter">
    <Setter Property="Background" Value="#112B23" />
    <Setter Property="BorderBrush" Value="#10B981" />
    <Setter Property="Foreground" Value="#6EE7B7" />
  </Style>

  <Style Selector="Button.SecondaryAction.ReloadSuccess:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#16382D" />
    <Setter Property="BorderBrush" Value="#34D399" />
    <Setter Property="Foreground" Value="#A7F3D0" />
  </Style>

  <Style Selector="Button.DangerAction">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#F87171" />
    <Setter Property="BorderBrush" Value="#5C2626" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.DangerAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A1619" />
    <Setter Property="BorderBrush" Value="#991B1B" />
  </Style>

  <Style Selector="Button.DangerAction:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.SecondaryAction.ActiveTab /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TundraAccent}" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraAccent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.SecondaryAction.ActiveTab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TundraAccentHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraAccentHover}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.SecondaryAction.ActiveTrashTab /template/ ContentPresenter">
    <Setter Property="Background" Value="#3B181C" />
    <Setter Property="BorderBrush" Value="#EF4444" />
    <Setter Property="Foreground" Value="#FECACA" />
  </Style>

  <Style Selector="Button.SecondaryAction.ActiveTrashTab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#4C1D24" />
    <Setter Property="BorderBrush" Value="#F87171" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="ListBox.NavList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.NavList > ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextSecondary}" />
  </Style>

  <Style Selector="ListBox.NavList > ListBoxItem:selected">
    <Setter Property="Background" Value="{StaticResource TundraElevatedBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
  </Style>

  <Style Selector="ListBox.FileGridList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.FileGridList > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource TundraCardBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox.FileGridList > ListBoxItem:pointerover">
    <Setter Property="BorderBrush" Value="#475569" />
  </Style>

  <Style Selector="ListBox.FileGridList > ListBoxItem:selected">
    <Setter Property="Background" Value="#1E2634" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraAccent}" />
  </Style>

  <Style Selector="ListBox.CardList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.CardList > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource TundraCardBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ListBox.CardList > ListBoxItem:pointerover">
    <Setter Property="BorderBrush" Value="#475569" />
  </Style>

  <Style Selector="ListBox.CardList > ListBoxItem:selected">
    <Setter Property="Background" Value="#1E2634" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraAccent}" />
  </Style>

  <Style Selector="ListBox.FlatRowList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.FlatRowList > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ListBox.FlatRowList > ListBoxItem:pointerover">
    <Setter Property="Background" Value="#1C222D" />
  </Style>

  <Style Selector="ListBox.FlatRowList > ListBoxItem:selected">
    <Setter Property="Background" Value="#1E293B" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="#252B36" />
    <Setter Property="Foreground" Value="{StaticResource TundraAccent}" />
  </Style>

  <Style Selector="PathIcon.Spinning">
    <Setter Property="RenderTransform">
      <RotateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="PathIcon.UploadPulse">
    <Setter Property="RenderTransform">
      <TranslateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.85" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="TranslateTransform.Y" Value="3" />
          <Setter Property="Opacity" Value="0.45" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="TranslateTransform.Y" Value="-3" />
          <Setter Property="Opacity" Value="1.0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="TranslateTransform.Y" Value="3" />
          <Setter Property="Opacity" Value="0.45" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="PathIcon.DownloadPulse">
    <Setter Property="RenderTransform">
      <TranslateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.85" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="TranslateTransform.Y" Value="-3" />
          <Setter Property="Opacity" Value="0.45" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="TranslateTransform.Y" Value="3" />
          <Setter Property="Opacity" Value="1.0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="TranslateTransform.Y" Value="-3" />
          <Setter Property="Opacity" Value="0.45" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="PathIcon.DeletePulse">
    <Setter Property="RenderTransform">
      <TranslateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.55" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="TranslateTransform.X" Value="-2.5" />
          <Setter Property="Opacity" Value="0.6" />
        </KeyFrame>
        <KeyFrame Cue="25%">
          <Setter Property="TranslateTransform.X" Value="2.5" />
          <Setter Property="Opacity" Value="1.0" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="TranslateTransform.X" Value="-2.5" />
          <Setter Property="Opacity" Value="0.8" />
        </KeyFrame>
        <KeyFrame Cue="75%">
          <Setter Property="TranslateTransform.X" Value="2.5" />
          <Setter Property="Opacity" Value="1.0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="TranslateTransform.X" Value="-2.5" />
          <Setter Property="Opacity" Value="0.6" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#141820" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="#1D2330" />
    <Setter Property="BorderBrush" Value="#475569" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
  </Style>

  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="#1E293B" />
    <Setter Property="Foreground" Value="#60A5FA" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="#16191F" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="#141820" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="#141820" />
    <Setter Property="BorderBrush" Value="{StaticResource TundraBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource TundraTextPrimary}" />
  </Style>

</Styles>

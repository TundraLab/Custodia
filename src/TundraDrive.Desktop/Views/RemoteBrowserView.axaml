<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TundraDrive.Desktop.ViewModels"
             x:Class="TundraDrive.Desktop.Views.RemoteBrowserView"
             x:DataType="vm:RemoteBrowserViewModel">

  <!-- Navegador remoto -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto" RowSpacing="8" ColumnSpacing="8">
      <Button Grid.Row="0" Grid.Column="0"
              Classes="SecondaryAction"
              Padding="8,4"
              IsEnabled="{Binding CanNavigateBack}"
              ToolTip.Tip="{Binding Loc.BackButton}"
              Command="{Binding NavigateBackCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Width="12" Height="12" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
          <TextBlock FontSize="12" Text="{Binding Loc.BackButton}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button Grid.Row="0" Grid.Column="1"
              Classes="SecondaryAction"
              Content="{Binding Loc.MyDriveLabel}"
              Command="{Binding NavigateToRootCommand}" />

      <TextBox Grid.Row="0" Grid.Column="2"
               Watermark="{Binding Loc.SearchRemoteWatermark}"
               Text="{Binding SearchQuery}"
               KeyDown="OnSearchBoxKeyDown" />

      <Button Grid.Row="0" Grid.Column="3"
              Classes="SecondaryAction"
              Content="{Binding Loc.SearchButton}"
              Command="{Binding SearchCommand}" />

      <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal">
        <Button Classes="SecondaryAction"
                Margin="0,0,6,0"
                Padding="10,5"
                Content="{Binding Loc.OpenFolderButton}"
                IsEnabled="{Binding CanOpenSelectedFolder}"
                Command="{Binding OpenNodeCommand}" />
        <Button Classes="SecondaryAction"
                Margin="0,0,6,0"
                Padding="10,5"
                Content="{Binding Loc.DownloadButton}"
                IsEnabled="{Binding CanDownloadSelectedFile}"
                Command="{Binding DownloadSelectedNodeCommand}" />
        <Button Classes="DangerAction"
                Margin="0,0,6,0"
                Padding="10,5"
                Content="{Binding Loc.MoveToTrashButton}"
                IsEnabled="{Binding HasSelectedNode}"
                Command="{Binding TrashSelectedNodeCommand}" />
        <Button Classes="PrimaryAction"
                Content="{Binding Loc.SyncSelectedFolderButton}"
                Command="{Binding SyncSelectedOrCurrentFolderCommand}" />
      </WrapPanel>
    </Grid>

    <Border Grid.Row="1" Classes="FlatRow" Padding="10,6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Breadcrumbs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RemoteBreadcrumbItem">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="{Binding Name}"
                          Command="{Binding SelectCommand}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="4,2"
                          FontSize="12.5"
                          Foreground="{StaticResource TundraTextPrimary}" />
                  <TextBlock Text="/" VerticalAlignment="Center" Classes="MutedMeta" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Button Grid.Column="1"
                Classes="SecondaryAction"
                Content="{Binding Loc.RefreshButton}"
                Command="{Binding LoadCurrentFolderCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="SurfaceCard" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BorderBrush="{StaticResource TundraBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
          <Grid ColumnDefinitions="*,110,90,135" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="MutedMeta" Text="{Binding Loc.ColName}" />
            <TextBlock Grid.Column="1" Classes="MutedMeta" Text="{Binding Loc.ColType}" />
            <TextBlock Grid.Column="2" Classes="MutedMeta" Text="{Binding Loc.ColSize}" />
            <TextBlock Grid.Column="3" Classes="MutedMeta" Text="{Binding Loc.ColModified}" />
          </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 Classes="FlatRowList"
                 ItemsSource="{Binding Nodes}"
                 SelectedItem="{Binding SelectedNode}"
                 DoubleTapped="OnNodeDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RemoteNodeItemViewModel">
              <Border Padding="8,6" Background="Transparent">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{Binding OpenLabel}"
                              IsVisible="{Binding IsFolder}"
                              Command="{Binding OpenCommand}" />
                    <MenuItem Header="{Binding DownloadLabel}"
                              IsVisible="{Binding !IsFolder}"
                              Command="{Binding DownloadCommand}" />
                    <MenuItem Header="{Binding SyncThisFolderLabel}"
                              IsVisible="{Binding IsFolder}"
                              Command="{Binding SyncThisFolderCommand}" />
                    <MenuItem Header="{Binding OpenInDriveLabel}"
                              Command="{Binding OpenInDriveCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding CopyNameLabel}"
                              Command="{Binding CopyNameCommand}" />
                    <MenuItem Header="{Binding CopyLinkLabel}"
                              Command="{Binding CopyLinkCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding TrashLabel}"
                              Command="{Binding TrashCommand}" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="*,110,90,135" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Width="15" Height="15"
                              Foreground="{StaticResource TundraAccent}"
                              IsVisible="{Binding IsFolder}"
                              Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                    <PathIcon Width="15" Height="15"
                              Foreground="{StaticResource TundraTextSecondary}"
                              IsVisible="{Binding !IsFolder}"
                              Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <TextBlock Grid.Column="1" Classes="MutedMeta" VerticalAlignment="Center" Text="{Binding TypeDisplay}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="MutedMeta" VerticalAlignment="Center" Text="{Binding SizeDisplay}" />
                  <TextBlock Grid.Column="3" Classes="MutedMeta" VerticalAlignment="Center" Text="{Binding ModifiedDisplay}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Classes="MutedMeta" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>

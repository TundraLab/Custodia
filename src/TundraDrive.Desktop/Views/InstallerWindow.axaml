<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TundraDrive.Desktop.ViewModels"
        x:Class="TundraDrive.Desktop.Views.InstallerWindow"
        x:DataType="vm:InstallerViewModel"
        Title="Instalador TundraDrive v2.6.0 • by TundraLab"
        Icon="avares://TundraDrive/Assets/tundradrive-icon.png"
        Width="780"
        Height="650"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TundraWindowBg}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <!-- Cabeçalho Proprietário TundraDrive by TundraLab -->
    <Border Grid.Row="0" Classes="SurfaceCard" Padding="18,16" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Border Grid.Column="0"
                Background="#13171F"
                BorderBrush="{StaticResource TundraBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
          <Image Source="avares://TundraDrive/Assets/tundradrive-icon.png"
                 Width="54"
                 Height="54"
                 Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock FontSize="20" FontWeight="Bold" Text="Instalador TundraDrive" />
            <Border Background="#1E3A8A" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
              <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#93C5FD" Text="{Binding AppVersion}" />
            </Border>
          </StackPanel>
          <TextBlock Classes="Subtitle"
                     Text="Assistente de instalação e integração para pacotes .rpm e .AppImage no Linux" />
          <TextBlock FontSize="11.5" Foreground="#60A5FA" Text="{Binding InstalledDetectionSummary}" />
        </StackPanel>

        <Border Grid.Column="2"
                Background="#13171F"
                BorderBrush="{StaticResource TundraBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="avares://TundraDrive/Assets/brand-logo.png"
                   Width="20"
                   Height="20"
                   Stretch="Uniform" />
            <StackPanel Spacing="1">
              <TextBlock FontSize="10.5" Foreground="#94A3B8" Text="PROPRIETARY INSTALLER" />
              <TextBlock FontSize="13" FontWeight="Bold" Text="by TundraLab" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Corpo -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <!-- Escolha do Formato (.AppImage vs .rpm) -->
        <Border Classes="SurfaceCard" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Classes="SectionTitle" Text="1. Formato do Pacote" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Button Grid.Column="0"
                      Command="{Binding SelectAppImageModeCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="14,12"
                      CornerRadius="10"
                      Background="#161C28"
                      BorderThickness="2"
                      BorderBrush="{Binding AppImageCardBorderBrush}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton IsChecked="{Binding IsAppImageSelected}" IsHitTestVisible="False" />
                    <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Text="Pacote .AppImage Integrado" />
                  </StackPanel>
                  <TextBlock Classes="Subtitle"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="Instala no perfil do usuário (~/.local/opt/tundradrive) sem exigir senha de root. Compatível com Fedora, Pop!_OS, Ubuntu, Debian e KDE Plasma." />
                </StackPanel>
              </Button>

              <Button Grid.Column="1"
                      Command="{Binding SelectRpmModeCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="14,12"
                      CornerRadius="10"
                      Background="#161C28"
                      BorderThickness="2"
                      BorderBrush="{Binding RpmCardBorderBrush}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton IsChecked="{Binding IsRpmSelected}" IsHitTestVisible="False" />
                    <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Text="Pacote Nativo .rpm (Sistema)" />
                  </StackPanel>
                  <TextBlock Classes="Subtitle"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="Instala no sistema (/opt/tundradrive e /usr/bin/tundradrive) via gerenciador RPM / DNF com autenticação Polkit. Ideal para Fedora Workstation e KDE." />
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0"
                       Text="{Binding SelectedPackagePath}"
                       Watermark="Caminho do arquivo .AppImage ou .rpm..."
                       IsReadOnly="True" />
              <Button Grid.Column="1"
                      Classes="SecondaryAction"
                      Command="{Binding BrowsePackageCommand}"
                      Content="Selecionar Pacote..." />
            </Grid>

            <TextBlock FontSize="11.5"
                       Foreground="#94A3B8"
                       Text="{Binding TargetInstallDestination, StringFormat='Destino: {0}'}" />
          </StackPanel>
        </Border>

        <!-- Opções de Integração -->
        <Border Classes="SurfaceCard" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Classes="SectionTitle" Text="2. Integração com o Sistema Linux" />

            <CheckBox IsChecked="{Binding CreateMenuShortcut}"
                      Content="Registrar no Menu de Aplicativos e atualizar ícones (GNOME, COSMIC e KDE Plasma 5/6)" />
            <CheckBox IsChecked="{Binding EnableAutostart}"
                      Content="Iniciar o TundraDrive automaticamente ao ligar o computador (XDG Autostart)" />
            <CheckBox IsChecked="{Binding CreateDesktopShortcut}"
                      Content="Criar atalho na Área de Trabalho" />
            <CheckBox IsChecked="{Binding InstallOptionalMediaPackages}"
                      IsVisible="{Binding IsRpmSelected}"
                      Content="Instalar pacotes recomendados de pré-visualização via DNF (poppler-utils, ffmpeg, libreoffice, ImageMagick)" />
          </StackPanel>
        </Border>

        <!-- Progresso e Log -->
        <Border Classes="SurfaceCard" Padding="16">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold" Text="{Binding StatusHeadline}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" FontSize="12" Foreground="#93C5FD" Text="{Binding ProgressValue, StringFormat='{}{0:0}%'}" />
            </Grid>

            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="8" CornerRadius="4" />

            <Border Background="#0D1017"
                    BorderBrush="{StaticResource TundraBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Height="105">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding LogLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock FontFamily="Monospace"
                                 FontSize="11.5"
                                 Foreground="#CBD5E1"
                                 Text="{Binding}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Rodapé de Ações -->
    <Border Grid.Row="2"
            Classes="SurfaceCard"
            Padding="16,12"
            Margin="0,14,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
          <TextBlock FontSize="12" FontWeight="SemiBold" Text="TundraDrive by TundraLab" />
          <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding DeveloperName}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button Classes="DangerAction"
                  Command="{Binding UninstallCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Content="Desinstalar" />
          <Button Classes="SecondaryAction"
                  Command="{Binding LaunchInstalledAppCommand}"
                  IsVisible="{Binding IsInstallCompleted}"
                  Content="Abrir TundraDrive" />
          <Button Classes="PrimaryAction"
                  Command="{Binding InstallCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Content="Instalar TundraDrive" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
